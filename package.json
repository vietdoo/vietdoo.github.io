{
  "name": "astro-bento-portfolio",
  "type": "module",
  "version": "0.0.2",
  "scripts": {
    "dev": "astro dev --remote",
    "start": "astro dev --remote",
    "build": "astro build --remote",
    "db:push": "node --input-type=module -e \"import { resolveDbConfig } from './node_modules/@astrojs/db/dist/core/load-file.js'; import { cmd } from './node_modules/@astrojs/db/dist/core/cli/commands/push/index.js'; const root = new URL('./', import.meta.url); const { dbConfig } = await resolveDbConfig({ root, integrations: [] }); await cmd({ dbConfig, flags: {} });\"",
    "preview": "astro preview",
    "astro": "astro",
    "site-setup": "node scripts/setup.mjs",
    "eslint": "eslint 'src/**/*.{js,astro}'",
    "check": "astro check",
    "format": "prettier --write \"src/**/*.{astro,ts,tsx,js,jsx,css,md}\"",
    "test": "vitest run",
    "ui:review": "node scripts/ui-review.mjs",
    "prepare": "husky"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.9",
    "@astrojs/db": "^0.21.3",
    "@astrojs/markdown-remark": "^7.2.1",
    "@astrojs/netlify": "^8.1.2",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.3",
    "@astrojs/solid-js": "^7.0.1",
    "@astrojs/svelte": "^9.0.1",
    "@astrojs/vercel": "^11.0.4",
    "@iconify-json/ri": "^1.2.10",
    "@rive-app/canvas": "2.37.1",
    "astro": "^7.0.9",
    "astro-icon": "^1.1.5",
    "astro-robots-txt": "^1.0.0",
    "autoprefixer": "^10.4.27",
    "cannon-es": "^0.20.0",
    "cloudinary": "^2.11.0",
    "d3": "^7.9.0",
    "dotenv": "^17.4.2",
    "gsap": "^3.14.2",
    "lenis": "^1.3.21",
    "mdast-util-to-string": "^4.0.0",
    "motion": "^12.38.0",
    "playwright": "^1.62.1",
    "reading-time": "^1.5.0",
    "rehype-mermaid": "^3.0.0",
    "sharp": "^0.34.5",
    "solid-js": "^1.9.14",
    "svelte": "^5.55.3",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@types/d3": "^7.4.3",
    "@types/markdown-it": "^14.2.0",
    "@types/sanitize-html": "^2.16.1",
    "@types/three": "^0.185.1",
    "@typescript-eslint/parser": "^8.58.1",
    "@unocss/astro": "^66.6.8",
    "@unocss/postcss": "^66.6.8",
    "@unocss/preset-uno": "^66.6.8",
    "@unocss/reset": "^66.6.8",
    "autoprefixer": "^10.4.27",
    "eslint": "^10.2.0",
    "eslint-plugin-astro": "^1.7.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "markdown-it": "^14.1.1",
    "motion": "^12.38.0",
    "prettier": "^3.8.3",
    "prettier-plugin-astro": "^0.14.1",
    "sanitize-html": "^2.17.2",
    "typescript": "^6.0.2",
    "unocss": "^66.6.8",
    "vitest": "^3.0.7"
  },
  "lint-staged": {
    "src/**/*.{js,astro}": [
      "eslint --fix"
    ]
  },
  "packageManager": "pnpm@10.33.0"
}
