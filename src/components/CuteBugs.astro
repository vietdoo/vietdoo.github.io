---
// CuteBugs.astro - Customizable AI Agent bugs (Claude, OpenAI, Gemini, Grok, DeepSeek, etc.) crawling with large crisp image logos & name tags
---

<div
  id="bugs-container"
  class="absolute inset-0 z-0 pointer-events-auto overflow-hidden select-none"
>
  <canvas id="bugs-canvas" class="w-full h-full block"></canvas>
</div>

<script>
  import {
    BUGS_CONFIG,
    DEV_JOKES,
    HIDING_JOKES,
    CLICK_JOKES,
    type BugDefinition,
  } from "../data/bugsConfig";

  interface Bug {
    id: number;
    species: string;
    name: string;
    x: number;
    y: number;
    targetX: number;
    targetY: number;
    angle: number;
    targetAngle: number;
    speed: number;
    baseSpeed: number;
    state: "WALK" | "PAUSE" | "HIDE" | "PEEK" | "SCARED";
    stateTimer: number;
    legPhase: number;
    size: number;
    hidingSpot: {
      x: number;
      y: number;
      edgeAngle: number;
      type: "edge" | "button";
    } | null;
    peekAmount: number;
    emotion: string | null;
    emotionTimer: number;
    chatText: string | null;
    chatTimer: number;
    nextChatTimer: number;
    sparkles: Array<{
      x: number;
      y: number;
      vy: number;
      alpha: number;
      char: string;
    }>;
    config: BugDefinition;
  }

  function drawRoundedRect(
    ctx: CanvasRenderingContext2D,
    x: number,
    y: number,
    w: number,
    h: number,
    r: number,
  ) {
    ctx.beginPath();
    ctx.moveTo(x + r, y);
    ctx.lineTo(x + w - r, y);
    ctx.arcTo(x + w, y, x + w, y + r, r);
    ctx.lineTo(x + w, y + h - r);
    ctx.arcTo(x + w, y + h, x + w - r, y + h, r);
    ctx.lineTo(x + r, y + h);
    ctx.arcTo(x, y + h, x, y + h - r, r);
    ctx.lineTo(x, y + r);
    ctx.arcTo(x, y, x + r, y, r);
    ctx.closePath();
  }

  function initCuteBugs() {
    const container = document.getElementById("bugs-container");
    const canvas = document.getElementById("bugs-canvas") as HTMLCanvasElement;
    if (!container || !canvas) return;

    const ctx = canvas.getContext("2d");
    if (!ctx) return;

    let width = 0;
    let height = 0;
    let animId: number;
    let dpr = window.devicePixelRatio || 1;

    let mouseX = -1000;
    let mouseY = -1000;
    let isHovering = false;

    // Cached bounds of the text/buttons block bugs and their speech bubbles should avoid.
    let avoidRect: {
      left: number;
      right: number;
      top: number;
      bottom: number;
    } | null = null;

    // Filter bugs enabled in bugsConfig.ts
    const activeBugsConfig = BUGS_CONFIG.filter((b) => b.enabled);
    if (activeBugsConfig.length === 0) return;

    // Preload downloaded logo images
    const bugImages: Record<string, HTMLImageElement> = {};
    activeBugsConfig.forEach((spec) => {
      const img = new Image();
      img.src = spec.imgUrl;
      bugImages[spec.id] = img;
    });

    const bugs: Bug[] = [];

    function resize() {
      const rect = container!.getBoundingClientRect();
      width = Math.max(100, rect.width);
      height = Math.max(100, rect.height);
      dpr = window.devicePixelRatio || 1;
      canvas.width = Math.floor(width * dpr);
      canvas.height = Math.floor(height * dpr);
      ctx!.setTransform(dpr, 0, 0, dpr, 0, 0);
      avoidRect = measureAvoidRect();

      bugs.forEach((b) => {
        const margin = b.size * 0.9;
        b.x = Math.max(margin, Math.min(width - margin, b.x));
        b.y = Math.max(height * 0.3, Math.min(maxBugY(b.size), b.y));
      });
    }

    // Lowest a bug can walk while its name tag still fits inside the canvas.
    function maxBugY(size: number) {
      return Math.max(size, height - (size * 1.05 + 18));
    }

    resize();
    // ⚡ Bolt: Debounce ResizeObserver callbacks by 250ms
    // Reduces main thread layout thrashing when container is repeatedly resized
    let resizeTimer: ReturnType<typeof setTimeout>;
    const resizeObserver = new ResizeObserver(() => {
      clearTimeout(resizeTimer);
      resizeTimer = setTimeout(() => {
        resize();
        if (bugs.length === 0 && width > 100 && height > 100) {
          initBugs();
        }
      }, 250);
    });
    resizeObserver.observe(container);

    // Bugs get smaller on cramped/mobile cards so they actually fit their play area.
    function getSizeScale() {
      const widthScale = width / 400;
      const heightScale = height / 300;
      return Math.max(0.55, Math.min(1, Math.min(widthScale, heightScale)));
    }

    // The text/buttons block bugs and their speech bubbles shouldn't cover, in container-relative coordinates.
    function measureAvoidRect() {
      const card = container!.closest(".card");
      const safeBelowEl = card?.querySelector<HTMLElement>(
        "[data-bug-safe-below]",
      );
      if (!card || !safeBelowEl) return null;
      const rect = safeBelowEl.getBoundingClientRect();
      const containerRect = container!.getBoundingClientRect();
      return {
        left: rect.left - containerRect.left,
        right: rect.right - containerRect.left,
        top: rect.top - containerRect.top,
        bottom: rect.bottom - containerRect.top,
      };
    }

    function getHidingSpots() {
      const spots: Array<{
        x: number;
        y: number;
        edgeAngle: number;
        type: "edge" | "button";
      }> = [];
      const introCard = container!.closest(".card");
      if (!introCard) return spots;

      spots.push({
        x: 40,
        y: height - 8,
        edgeAngle: -Math.PI / 2,
        type: "edge",
      });
      spots.push({
        x: width / 2,
        y: height - 8,
        edgeAngle: -Math.PI / 2,
        type: "edge",
      });
      spots.push({
        x: width - 50,
        y: height - 8,
        edgeAngle: -Math.PI / 2,
        type: "edge",
      });
      spots.push({ x: 12, y: height * 0.75, edgeAngle: 0, type: "edge" });

      const buttons = introCard.querySelectorAll("button, a");
      const containerRect = container!.getBoundingClientRect();

      buttons.forEach((btn) => {
        const btnRect = btn.getBoundingClientRect();
        const relX = btnRect.left - containerRect.left + btnRect.width / 2;
        const relY = btnRect.top - containerRect.top + btnRect.height;
        if (relX > 0 && relX < width && relY > 0 && relY < height) {
          spots.push({
            x: relX,
            y: relY - 4,
            edgeAngle: -Math.PI / 2,
            type: "button",
          });
        }
      });

      return spots;
    }

    // Picks a random walk target, steering clear of the text/buttons block whenever there's
    // enough room; falls back to the strip just below that block on very cramped cards.
    function pickWalkPoint(size: number) {
      const margin = size * 0.85;
      const minX = margin;
      const maxX = Math.max(minX + 20, width - margin);
      const minY = Math.max(40, height * 0.3);
      const maxY = Math.max(minY + 20, maxBugY(size));
      const avoid = avoidRect;

      if (avoid) {
        const pad = size * 0.5;
        for (let attempt = 0; attempt < 8; attempt++) {
          const x = minX + Math.random() * (maxX - minX);
          const y = minY + Math.random() * (maxY - minY);
          const inside =
            x > avoid.left - pad &&
            x < avoid.right + pad &&
            y > avoid.top - pad &&
            y < avoid.bottom + pad;
          if (!inside) return { x, y };
        }
        // No free spot found after several tries (very cramped card): hug the floor
        // just beneath the text/buttons block instead of overlapping it.
        const fallbackY = Math.min(
          Math.max(avoid.bottom + size * 0.6, minY),
          maxY,
        );
        return { x: minX + Math.random() * (maxX - minX), y: fallbackY };
      }

      return {
        x: minX + Math.random() * (maxX - minX),
        y: minY + Math.random() * (maxY - minY),
      };
    }

    function setRandomWalkTarget(bug: Bug) {
      const point = pickWalkPoint(bug.size);
      bug.targetX = point.x;
      bug.targetY = point.y;
      bug.state = "WALK";
      bug.stateTimer = 3 + Math.random() * 4;
      bug.speed = bug.baseSpeed;
      bug.hidingSpot = null;
    }

    function setHidingTarget(bug: Bug) {
      const spots = getHidingSpots();
      if (spots.length === 0) {
        setRandomWalkTarget(bug);
        return;
      }
      const spot = spots[Math.floor(Math.random() * spots.length)];
      bug.hidingSpot = spot;
      bug.targetX = spot.x;
      bug.targetY = spot.y;
      bug.state = "HIDE";
      bug.speed = bug.baseSpeed * 1.3;
    }

    function speakJoke(bug: Bug, defaultJokes?: string[]) {
      let list = defaultJokes;
      if (!list) {
        const agentJokes = bug.config.jokes;
        if (Math.random() < 0.7 && agentJokes && agentJokes.length > 0) {
          list = agentJokes;
        } else {
          list = DEV_JOKES;
        }
      }
      const joke = list[Math.floor(Math.random() * list.length)];
      bug.chatText = joke;
      bug.chatTimer = 3.5;
    }

    function initBugs() {
      bugs.length = 0;
      const sizeScale = getSizeScale();
      // Narrow cards (mobile) only get a few bugs so their name tags and speech bubbles don't pile up.
      const spawnConfig =
        width < 420 ? activeBugsConfig.slice(0, 3) : activeBugsConfig;
      spawnConfig.forEach((specInfo, i) => {
        const bug: Bug = {
          id: i,
          species: specInfo.id,
          name: specInfo.name,
          x: 35 + (i + 1) * ((width - 70) / (spawnConfig.length + 1)),
          y: height * 0.65 + (Math.random() - 0.5) * 30,
          targetX: 0,
          targetY: 0,
          angle: Math.random() * Math.PI * 2,
          targetAngle: 0,
          speed: 0.85 + Math.random() * 0.35,
          baseSpeed: 0.85 + Math.random() * 0.35,
          state: "WALK",
          stateTimer: 2 + Math.random() * 3,
          legPhase: Math.random() * Math.PI * 2,
          size: (25 + Math.random() * 3) * sizeScale,
          hidingSpot: null,
          peekAmount: 0,
          emotion: null,
          emotionTimer: 0,
          chatText: null,
          chatTimer: 0,
          nextChatTimer: 1.5 + i * 2.2 + Math.random() * 2.5,
          sparkles: [],
          config: specInfo,
        };
        setRandomWalkTarget(bug);
        bugs.push(bug);
      });
    }

    initBugs();

    function triggerEmotion(bug: Bug, char: string) {
      bug.emotion = char;
      bug.emotionTimer = 1.4;
    }

    function addSparkles(bug: Bug, char = "♥") {
      for (let i = 0; i < 4; i++) {
        bug.sparkles.push({
          x: bug.x + (Math.random() - 0.5) * 16,
          y: bug.y - 10,
          vy: -0.9 - Math.random() * 0.9,
          alpha: 1,
          char,
        });
      }
    }

    container.addEventListener("mousemove", (e) => {
      const rect = container.getBoundingClientRect();
      mouseX = e.clientX - rect.left;
      mouseY = e.clientY - rect.top;
      isHovering = true;
    });

    container.addEventListener("mouseleave", () => {
      isHovering = false;
      mouseX = -1000;
      mouseY = -1000;
    });

    container.addEventListener("click", (e) => {
      const rect = container.getBoundingClientRect();
      const clickX = e.clientX - rect.left;
      const clickY = e.clientY - rect.top;

      bugs.forEach((bug) => {
        const dx = bug.x - clickX;
        const dy = bug.y - clickY;
        const dist = Math.hypot(dx, dy);

        if (dist < bug.size * 1.8) {
          triggerEmotion(bug, "♥");
          addSparkles(bug, Math.random() > 0.5 ? "♥" : "✨");
          speakJoke(bug, CLICK_JOKES);
          bug.state = "SCARED";
          bug.stateTimer = 1.8;
          bug.speed = bug.baseSpeed * 2.5;
          bug.targetX = bug.x + Math.sign(dx || 1) * (80 + Math.random() * 60);
          bug.targetY = bug.y + Math.sign(dy || 1) * (50 + Math.random() * 40);
          bug.targetX = Math.max(
            bug.size * 0.85,
            Math.min(width - bug.size * 0.85, bug.targetX),
          );
          bug.targetY = Math.max(
            height * 0.3,
            Math.min(maxBugY(bug.size), bug.targetY),
          );
        }
      });
    });

    let lastTime = performance.now();

    function update(dt: number) {
      bugs.forEach((bug) => {
        if (bug.emotionTimer > 0) {
          bug.emotionTimer -= dt;
          if (bug.emotionTimer <= 0) bug.emotion = null;
        }

        if (bug.chatTimer > 0) {
          bug.chatTimer -= dt;
          if (bug.chatTimer <= 0) bug.chatText = null;
        }

        bug.nextChatTimer -= dt;
        if (bug.nextChatTimer <= 0) {
          if (bug.state === "PEEK") {
            speakJoke(bug, HIDING_JOKES);
          } else {
            speakJoke(bug);
          }
          bug.nextChatTimer = 5 + Math.random() * 7;
        }

        bug.sparkles.forEach((s) => {
          s.y += s.vy;
          s.alpha -= dt * 1.2;
        });
        bug.sparkles = bug.sparkles.filter((s) => s.alpha > 0);

        if (isHovering && bug.state !== "SCARED" && bug.state !== "PEEK") {
          const dx = bug.x - mouseX;
          const dy = bug.y - mouseY;
          const dist = Math.hypot(dx, dy);
          if (dist < 35) {
            triggerEmotion(bug, "!");
            bug.state = "SCARED";
            bug.stateTimer = 1.5;
            bug.speed = bug.baseSpeed * 2.2;
            bug.targetX = bug.x + (dx / (dist || 1)) * 90;
            bug.targetY = bug.y + (dy / (dist || 1)) * 70;
            bug.targetX = Math.max(
              bug.size * 0.85,
              Math.min(width - bug.size * 0.85, bug.targetX),
            );
            bug.targetY = Math.max(
              height * 0.3,
              Math.min(maxBugY(bug.size), bug.targetY),
            );
          }
        }

        switch (bug.state) {
          case "WALK":
          case "HIDE":
          case "SCARED": {
            const dx = bug.targetX - bug.x;
            const dy = bug.targetY - bug.y;
            const dist = Math.hypot(dx, dy);

            if (dist < 10) {
              if (bug.state === "HIDE") {
                bug.state = "PEEK";
                bug.stateTimer = 3 + Math.random() * 4;
                bug.peekAmount = 0.75;
                triggerEmotion(bug, "?");
                speakJoke(bug, HIDING_JOKES);
              } else if (bug.state === "SCARED") {
                setHidingTarget(bug);
              } else {
                const rand = Math.random();
                if (rand < 0.4) setHidingTarget(bug);
                else if (rand < 0.7) {
                  bug.state = "PAUSE";
                  bug.stateTimer = 1.5 + Math.random() * 2.5;
                } else setRandomWalkTarget(bug);
              }
            } else {
              bug.targetAngle = Math.atan2(dy, dx);
              let diff = bug.targetAngle - bug.angle;
              while (diff < -Math.PI) diff += Math.PI * 2;
              while (diff > Math.PI) diff -= Math.PI * 2;
              bug.angle += diff * Math.min(1, dt * 8);

              bug.x += Math.cos(bug.angle) * bug.speed * (dt * 60);
              bug.y += Math.sin(bug.angle) * bug.speed * (dt * 60);

              bug.legPhase += bug.speed * dt * 14;
              bug.peekAmount = Math.max(0, bug.peekAmount - dt * 2);
            }

            bug.stateTimer -= dt;
            if (bug.stateTimer <= 0 && bug.state === "WALK") {
              if (Math.random() < 0.5) setHidingTarget(bug);
              else setRandomWalkTarget(bug);
            }
            break;
          }

          case "PAUSE": {
            bug.legPhase += dt * 2;
            bug.stateTimer -= dt;
            if (bug.stateTimer <= 0) {
              if (Math.random() < 0.6) setHidingTarget(bug);
              else setRandomWalkTarget(bug);
            }
            break;
          }

          case "PEEK": {
            bug.legPhase += dt * 1.5;
            bug.stateTimer -= dt;
            bug.peekAmount = 0.7 + Math.sin(performance.now() * 0.004) * 0.1;

            if (bug.stateTimer <= 0) {
              bug.state = "WALK";
              triggerEmotion(bug, "✨");
              setRandomWalkTarget(bug);
            }
            break;
          }
        }
      });
    }

    function drawBug(b: Bug) {
      ctx!.save();
      ctx!.translate(b.x, b.y);

      const renderAngle =
        b.state === "PEEK" && b.hidingSpot ? b.hidingSpot.edgeAngle : b.angle;
      const s = b.size;

      // Draw Sparks/Hearts
      b.sparkles.forEach((sp) => {
        ctx!.save();
        ctx!.globalAlpha = sp.alpha;
        ctx!.fillStyle = "#f43f5e";
        ctx!.font = "bold 9px sans-serif";
        ctx!.fillText(sp.char, sp.x - b.x, sp.y - b.y);
        ctx!.restore();
      });

      // Draw Dev Joke Chat Bubble in White-Gray Slate Theme (Boundary-clamped)
      if (b.chatText && b.chatTimer > 0) {
        ctx!.save();
        const font =
          'bold 8.5px -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif';
        ctx!.font = font;
        const textWidth = ctx!.measureText(b.chatText).width;
        const padX = 6;
        const bubbleW = textWidth + padX * 2;
        const bubbleH = 16;
        const margin = 6;

        // Clamp horizontal bubble box position so it never overflows canvas
        let bX = -bubbleW / 2;
        const minRelativeX = margin - b.x;
        const maxRelativeX = width - margin - b.x;

        if (bX < minRelativeX) {
          bX = minRelativeX;
        }
        if (bX + bubbleW > maxRelativeX) {
          bX = maxRelativeX - bubbleW;
        }

        // Clamp vertical position if bug is near the top edge, or if the bubble
        // would land on top of the text/buttons block (checking horizontal overlap too,
        // since on desktop that block only occupies part of the card's width).
        let bY = -s * 1.65 - bubbleH;
        let isAbove = true;
        let minAllowedTop = margin;
        if (avoidRect) {
          const bubbleAbsLeft = b.x + bX;
          const bubbleAbsRight = b.x + bX + bubbleW;
          const overlapsAvoidX =
            bubbleAbsRight > avoidRect.left && bubbleAbsLeft < avoidRect.right;
          if (overlapsAvoidX) {
            minAllowedTop = Math.max(margin, avoidRect.bottom + margin);
          }
        }
        if (b.y + bY < minAllowedTop) {
          bY = s * 1.65;
          isAbove = false;
        }

        // Compute pointer triangle position to always point to bug head (0,0)
        const pointerX = Math.max(bX + 6, Math.min(bX + bubbleW - 6, 0));

        ctx!.globalAlpha = Math.min(1, b.chatTimer * 2.5);

        // Soft Drop Shadow
        ctx!.shadowColor = "rgba(0, 0, 0, 0.4)";
        ctx!.shadowBlur = 4;
        ctx!.shadowOffsetY = 1.5;

        // White-Gray Bubble Box
        ctx!.fillStyle = "#f8fafc";
        ctx!.strokeStyle = "#cbd5e1";
        ctx!.lineWidth = 1.0;
        drawRoundedRect(ctx!, bX, bY, bubbleW, bubbleH, 4);
        ctx!.fill();
        ctx!.stroke();

        // Pointer triangle
        ctx!.beginPath();
        if (isAbove) {
          ctx!.moveTo(pointerX - 3, bY + bubbleH - 0.5);
          ctx!.lineTo(pointerX, bY + bubbleH + 3.5);
          ctx!.lineTo(pointerX + 3, bY + bubbleH - 0.5);
        } else {
          ctx!.moveTo(pointerX - 3, bY + 0.5);
          ctx!.lineTo(pointerX, bY - 3.5);
          ctx!.lineTo(pointerX + 3, bY + 0.5);
        }
        ctx!.closePath();
        ctx!.fill();
        ctx!.stroke();

        // Reset shadow for text
        ctx!.shadowColor = "transparent";

        // Crisp Dark Slate Text
        ctx!.fillStyle = "#0f172a";
        ctx!.textAlign = "center";
        ctx!.textBaseline = "middle";
        ctx!.fillText(b.chatText, bX + bubbleW / 2, bY + bubbleH / 2 + 0.5);
        ctx!.restore();
      }

      // Draw Upright Agent Name Tag (Non-rotated, always horizontal and clean)
      if (b.peekAmount < 0.4) {
        ctx!.save();
        const nameFont =
          'bold 8.5px -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif';
        ctx!.font = nameFont;
        const nameW = ctx!.measureText(b.name).width + 10;
        const nameH = 13;
        // Flip the tag above the bug when there's no room for it below (e.g. bugs
        // hiding at the bottom edge, or the short bug strip on mobile).
        const nameY =
          b.y + s * 1.05 + nameH + 4 > height ? -(s * 1.05 + nameH) : s * 1.05;

        const accentBorder = b.config.colors.accent || "#d97706";

        ctx!.shadowColor = "rgba(0, 0, 0, 0.45)";
        ctx!.shadowBlur = 4;
        ctx!.shadowOffsetY = 1;

        ctx!.fillStyle = "rgba(15, 23, 42, 0.9)";
        ctx!.strokeStyle = accentBorder;
        ctx!.lineWidth = 1.0;

        drawRoundedRect(ctx!, -nameW / 2, nameY, nameW, nameH, 3.5);
        ctx!.fill();
        ctx!.stroke();

        ctx!.shadowColor = "transparent";
        ctx!.fillStyle = "#f8fafc";
        ctx!.textAlign = "center";
        ctx!.textBaseline = "middle";
        ctx!.fillText(b.name, 0, nameY + nameH / 2 + 0.5);
        ctx!.restore();
      }

      // Rotate for drawing body/legs/antennae
      ctx!.rotate(renderAngle + Math.PI / 2);

      // Draw Emotion indicator if present
      if (b.emotion && !b.chatText) {
        ctx!.save();
        ctx!.shadowColor = "rgba(0, 0, 0, 0.4)";
        ctx!.shadowBlur = 4;
        ctx!.shadowOffsetY = 1.5;

        ctx!.fillStyle = "#f8fafc";
        ctx!.strokeStyle = "#cbd5e1";
        ctx!.lineWidth = 1.0;
        const eX = 0;
        const eY = -s * 1.35;

        ctx!.beginPath();
        ctx!.arc(eX, eY, 7, 0, Math.PI * 2);
        ctx!.fill();
        ctx!.stroke();

        ctx!.shadowColor = "transparent";
        ctx!.fillStyle = "#0f172a";
        ctx!.font = "bold 8px sans-serif";
        ctx!.textAlign = "center";
        ctx!.textBaseline = "middle";
        ctx!.fillText(b.emotion, eX, eY);
        ctx!.restore();
      }

      // Clip if peeking
      if (b.peekAmount > 0) {
        ctx!.beginPath();
        ctx!.rect(-s * 1.5, -s * 1.5 + b.peekAmount * s * 1.2, s * 3, s * 3);
        ctx!.clip();
      }

      // 6 Wiggly Legs
      ctx!.strokeStyle = "#0f172a";
      ctx!.lineWidth = 1.7;
      ctx!.lineCap = "round";

      for (let side = -1; side <= 1; side += 2) {
        for (let legIdx = 0; legIdx < 3; legIdx++) {
          const legY = (legIdx - 1) * (s * 0.3);
          const phaseOffset = legIdx * 0.8 + (side > 0 ? Math.PI : 0);
          const legSwing = Math.sin(b.legPhase + phaseOffset) * 0.45;

          const startX = side * (s * 0.35);
          const startY = legY;
          const midX = side * (s * 0.68 + Math.cos(legSwing) * 3);
          const midY = legY + Math.sin(legSwing) * 5;
          const endX = side * (s * 0.9);
          const endY = legY + side * legSwing * 6;

          ctx!.beginPath();
          ctx!.moveTo(startX, startY);
          ctx!.quadraticCurveTo(midX, midY, endX, endY);
          ctx!.stroke();
        }
      }

      // Antennae Tip Color per AI Agent Config
      const tipColor = b.config.colors.tip || "#f59e0b";

      // Antennae
      const antennaPhase = Math.sin(performance.now() * 0.008 + b.id) * 0.25;
      ctx!.strokeStyle = "#0f172a";
      ctx!.lineWidth = 1.4;

      for (let side = -1; side <= 1; side += 2) {
        const aX = side * (s * 0.2);
        const aY = -s * 0.45;
        const tipX = side * (s * 0.55) + antennaPhase * 4;
        const tipY = -s * 0.9;

        ctx!.beginPath();
        ctx!.moveTo(aX, aY);
        ctx!.quadraticCurveTo(side * (s * 0.35), -s * 0.75, tipX, tipY);
        ctx!.stroke();

        ctx!.fillStyle = tipColor;
        ctx!.beginPath();
        ctx!.arc(tipX, tipY, 2.1, 0, Math.PI * 2);
        ctx!.fill();
      }

      // Body & Shell per AI Agent Species Config
      ctx!.save();

      const colors = b.config.colors;
      const grad = ctx!.createLinearGradient(
        -s * 0.4,
        -s * 0.4,
        s * 0.4,
        s * 0.4,
      );
      if (colors.gradient.length === 1) {
        grad.addColorStop(0, colors.gradient[0]);
        grad.addColorStop(1, colors.gradient[0]);
      } else {
        colors.gradient.forEach((c, idx) => {
          grad.addColorStop(idx / (colors.gradient.length - 1), c);
        });
      }

      ctx!.fillStyle = grad;
      ctx!.beginPath();
      ctx!.ellipse(0, 0, s * 0.46, s * 0.54, 0, 0, Math.PI * 2);
      ctx!.fill();

      // Rim accent if grok or custom
      if (b.species === "grok") {
        ctx!.strokeStyle = "rgba(56, 189, 248, 0.5)";
        ctx!.lineWidth = 1.2;
        ctx!.stroke();
      }

      // Head
      ctx!.fillStyle = colors.head;
      ctx!.beginPath();
      ctx!.ellipse(0, -s * 0.42, s * 0.3, s * 0.22, 0, 0, Math.PI * 2);
      ctx!.fill();

      // Center seam
      ctx!.strokeStyle = colors.seam;
      ctx!.lineWidth = 1.5;
      ctx!.beginPath();
      ctx!.moveTo(0, -s * 0.3);
      ctx!.lineTo(0, s * 0.5);
      ctx!.stroke();

      // Render Downloaded PNG Logo Image on Shell Back
      const logoImg = bugImages[b.config.id];
      if (logoImg && logoImg.complete && logoImg.naturalWidth > 0) {
        ctx!.save();
        ctx!.translate(0, s * 0.04);
        const logoR = s * 0.38;

        // Drop shadow for logo circle badge
        ctx!.shadowColor = "rgba(0, 0, 0, 0.4)";
        ctx!.shadowBlur = 4;
        ctx!.shadowOffsetY = 1;

        // White circular backing for crisp icon contrast
        ctx!.fillStyle = "#ffffff";
        ctx!.beginPath();
        ctx!.arc(0, 0, logoR, 0, Math.PI * 2);
        ctx!.fill();

        ctx!.shadowColor = "transparent";

        // Clip image inside circular badge
        ctx!.beginPath();
        ctx!.arc(0, 0, logoR - 0.5, 0, Math.PI * 2);
        ctx!.clip();

        ctx!.drawImage(logoImg, -logoR, -logoR, logoR * 2, logoR * 2);
        ctx!.restore();
      }

      // Glossy Highlight
      ctx!.fillStyle = "rgba(255, 255, 255, 0.35)";
      ctx!.beginPath();
      ctx!.ellipse(
        -s * 0.16,
        -s * 0.16,
        s * 0.11,
        s * 0.2,
        -Math.PI / 4,
        0,
        Math.PI * 2,
      );
      ctx!.fill();

      // Cute Big White Eyes
      ctx!.fillStyle = "#ffffff";
      ctx!.beginPath();
      ctx!.arc(-s * 0.13, -s * 0.46, s * 0.095, 0, Math.PI * 2);
      ctx!.arc(s * 0.13, -s * 0.46, s * 0.095, 0, Math.PI * 2);
      ctx!.fill();

      // Black Pupils
      ctx!.fillStyle = "#0f172a";
      if (b.state === "PEEK" || b.state === "PAUSE") {
        const pX = Math.sin(performance.now() * 0.004) * (s * 0.03);
        ctx!.beginPath();
        ctx!.arc(-s * 0.13 + pX, -s * 0.46, s * 0.05, 0, Math.PI * 2);
        ctx!.arc(s * 0.13 + pX, -s * 0.46, s * 0.05, 0, Math.PI * 2);
        ctx!.fill();
      } else {
        ctx!.beginPath();
        ctx!.arc(-s * 0.13, -s * 0.47, s * 0.05, 0, Math.PI * 2);
        ctx!.arc(s * 0.13, -s * 0.47, s * 0.05, 0, Math.PI * 2);
        ctx!.fill();
      }

      ctx!.restore();
      ctx!.restore();
    }

    function render(time: number) {
      const dt = Math.min(0.1, (time - lastTime) / 1000);
      lastTime = time;

      ctx!.clearRect(0, 0, width, height);

      update(dt);
      bugs.forEach(drawBug);

      animId = requestAnimationFrame(render);
    }

    animId = requestAnimationFrame(render);

    return () => {
      cancelAnimationFrame(animId);
      clearTimeout(resizeTimer);
      resizeObserver.disconnect();
    };
  }

  let cleanup: (() => void) | undefined;

  function setup() {
    if (cleanup) cleanup();
    cleanup = initCuteBugs();
  }

  if (
    document.readyState === "complete" ||
    document.readyState === "interactive"
  ) {
    setup();
  } else {
    document.addEventListener("DOMContentLoaded", setup);
  }

  document.addEventListener("astro:page-load", setup);
  document.addEventListener("astro:before-swap", () => {
    if (cleanup) cleanup();
  });
</script>
