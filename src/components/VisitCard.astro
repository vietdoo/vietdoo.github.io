---
import Card from "./Card/index.astro";

interface Props {
  colSpan?: string;
}

const { colSpan = "md:col-span-1 lg:col-span-2" } = Astro.props;
---

<Card
  colSpan={colSpan}
  href="visit"
  rowSpan="md:row-span-1"
  height="min-h-[82px] sm:min-h-[96px] md:min-h-0 md:h-full"
  padding="p-3 sm:p-4"
  arrowCorner
  title="Journey"
>
  <div
    slot="background"
    class="visit-card-bg absolute inset-0 -z-10 overflow-hidden pointer-events-none"
    aria-hidden="true"
  >
    <canvas class="journey-path-canvas absolute inset-0 w-full h-full"></canvas>
  </div>
</Card>

<script is:inline>
  (function setupJourneyPathfinder() {
    let animId = null;
    let resizeObserver = null;
    let intersectionObserver = null;
    let isVisible = true;

    function init() {
      const container = document.querySelector(".visit-card-bg");
      if (!container) return;
      const canvas = container.querySelector(".journey-path-canvas");
      if (!canvas) return;

      if (canvas.dataset.initialized === "true") return;
      canvas.dataset.initialized = "true";

      const card = container.closest(".card");
      const ctx = canvas.getContext("2d");
      if (!ctx) return;

      let cellSize = 18;
      let width = 0;
      let height = 0;
      let cols = 0;
      let rows = 5;
      let offsetX = 0;
      let offsetY = 0;
      const obstacles = new Map();
      let start = { c: 0, r: 0 };
      let target = { c: 0, r: 0 };
      let exploredNodes = [];
      let shortestPath = [];
      let state = "SEARCHING"; // SEARCHING, PATH_DRAW, RUNNER, HOLD, FADING
      let stateTime = performance.now();
      let exploreIndex = 0;
      let pathLengthDrawn = 0;
      let runnerPos = 0;
      let rippleR = 0;
      let rippleAlpha = 0;
      let fadeAlpha = 1;
      let isHovered = false;
      let hoverTarget = null;
      let holdDuration = 1800;

      function getPrimaryColor() {
        const isLight = document.documentElement.dataset.uiTheme === "light";
        if (isLight) return "#8b493b";
        const style = getComputedStyle(document.body);
        const p = style.getPropertyValue("--primary-500")?.trim();
        return p || "#38bdf8";
      }

      function getRgb(color) {
        if (color.startsWith("#")) {
          const hex = color.slice(1);
          if (hex.length === 3) {
            return [
              parseInt(hex[0] + hex[0], 16),
              parseInt(hex[1] + hex[1], 16),
              parseInt(hex[2] + hex[2], 16),
            ];
          }
          if (hex.length >= 6) {
            return [
              parseInt(hex.slice(0, 2), 16),
              parseInt(hex.slice(2, 4), 16),
              parseInt(hex.slice(4, 6), 16),
            ];
          }
        }
        if (color.startsWith("rgb")) {
          const match = color.match(/\d+/g);
          if (match && match.length >= 3) {
            return [Number(match[0]), Number(match[1]), Number(match[2])];
          }
        }
        return [56, 189, 248];
      }

      function resize() {
        const rect = container.getBoundingClientRect();
        if (rect.width === 0 || rect.height === 0) return;
        const dpr = Math.min(window.devicePixelRatio || 1, 2);
        width = rect.width;
        height = rect.height;
        canvas.width = Math.floor(width * dpr);
        canvas.height = Math.floor(height * dpr);
        ctx.setTransform(dpr, 0, 0, dpr, 0, 0);

        // Fixed to exactly 5 rows as requested
        rows = 5;
        const padY = 16;
        cellSize = Math.max(14, Math.min(21, Math.floor((height - padY) / (rows - 1))));
        cols = Math.max(8, Math.floor((width - 24) / cellSize) + 1);
        offsetX = (width - (cols - 1) * cellSize) / 2;
        offsetY = (height - (rows - 1) * cellSize) / 2;

        startNewJourney(true);
      }

      function key(c, r) {
        return `${c},${r}`;
      }

      function parseKey(k) {
        const idx = k.indexOf(",");
        return {
          c: Number(k.slice(0, idx)),
          r: Number(k.slice(idx + 1)),
        };
      }

      function generateObstacles() {
        obstacles.clear();
        // Number of obstacles: x2 (~22% of cells)
        const targetCount = Math.floor(cols * rows * 0.22);
        let attempts = 0;
        while (obstacles.size < targetCount && attempts < targetCount * 4) {
          attempts++;
          const c = Math.floor(Math.random() * cols);
          const r = Math.floor(Math.random() * rows);
          // 60% trees, 40% rocks
          const type = Math.random() < 0.6 ? "tree" : "rock";
          const variant = Math.random() < 0.5 ? 0 : 1;
          obstacles.set(key(c, r), { type, variant });
        }
      }

      function solveBFS(s, t) {
        const targetK = key(t.c, t.r);
        const q = [key(s.c, s.r)];
        const visited = new Set([key(s.c, s.r)]);
        const parent = new Map();
        const order = [];

        while (q.length > 0) {
          const currK = q.shift();
          if (currK === targetK) break;
          const { c, r } = parseKey(currK);
          const neighbors = [
            { c: c + 1, r },
            { c: c - 1, r },
            { c, r: r + 1 },
            { c, r: r - 1 },
          ];

          for (let i = 0; i < neighbors.length; i++) {
            const n = neighbors[i];
            if (n.c >= 0 && n.c < cols && n.r >= 0 && n.r < rows) {
              const nK = key(n.c, n.r);
              if (!obstacles.has(nK) && !visited.has(nK)) {
                visited.add(nK);
                parent.set(nK, currK);
                q.push(nK);
                order.push(n);
              }
            }
          }
        }

        const path = [];
        if (parent.has(targetK) || targetK === key(s.c, s.r)) {
          let curr = targetK;
          while (curr) {
            path.unshift(parseKey(curr));
            curr = parent.get(curr);
          }
        }
        return { path, order };
      }

      function startNewJourney(fullReset = false) {
        if (fullReset || obstacles.size === 0) {
          generateObstacles();
        }

        if (shortestPath.length > 0 && !fullReset) {
          start = { ...shortestPath[shortestPath.length - 1] };
        } else {
          do {
            start = {
              c: Math.floor(Math.random() * Math.max(1, Math.floor(cols * 0.35))),
              r: Math.floor(Math.random() * rows),
            };
          } while (obstacles.has(key(start.c, start.r)));
        }

        let bestT = null;
        let bestDist = 0;
        for (let tries = 0; tries < 25; tries++) {
          const candidate = {
            c: Math.floor(Math.random() * cols),
            r: Math.floor(Math.random() * rows),
          };
          const dist = Math.abs(candidate.c - start.c) + Math.abs(candidate.r - start.r);
          if (!obstacles.has(key(candidate.c, candidate.r)) && dist > bestDist) {
            bestDist = dist;
            bestT = candidate;
          }
        }
        if (!bestT) {
          for (let c = cols - 1; c >= 0; c--) {
            for (let r = rows - 1; r >= 0; r--) {
              if (!obstacles.has(key(c, r))) {
                bestT = { c, r };
                break;
              }
            }
            if (bestT) break;
          }
        }
        target = bestT || { c: 0, r: 0 };

        let res = solveBFS(start, target);
        let retries = 0;
        while (res.path.length === 0 && retries < 8) {
          // If completely boxed in, regenerate
          generateObstacles();
          res = solveBFS(start, target);
          retries++;
        }

        exploredNodes = res.order;
        shortestPath = res.path;
        exploreIndex = 0;
        pathLengthDrawn = 0;
        runnerPos = 0;
        rippleR = 0;
        rippleAlpha = 0;
        fadeAlpha = 1;
        state = "SEARCHING";
        stateTime = performance.now();
      }

      function pos(c, r) {
        return {
          x: offsetX + c * cellSize,
          y: offsetY + r * cellSize,
        };
      }

      function getClosestFreeCell(c, r) {
        if (!obstacles.has(key(c, r))) return { c, r };

        // If cursor is on an obstacle (rock/tree), find closest passable neighbor
        const candidates = [];
        for (let dc = -2; dc <= 2; dc++) {
          for (let dr = -2; dr <= 2; dr++) {
            const nc = c + dc;
            const nr = r + dr;
            if (nc >= 0 && nc < cols && nr >= 0 && nr < rows) {
              if (!obstacles.has(key(nc, nr))) {
                candidates.push({ c: nc, r: nr, dist: Math.hypot(dc, dr) });
              }
            }
          }
        }
        candidates.sort((a, b) => a.dist - b.dist);
        return candidates.length > 0 ? { c: candidates[0].c, r: candidates[0].r } : null;
      }

      // Mouse interactivity
      if (card) {
        card.addEventListener("mousemove", (e) => {
          const rect = canvas.getBoundingClientRect();
          const mx = e.clientX - rect.left;
          const my = e.clientY - rect.top;
          const rawC = Math.round((mx - offsetX) / cellSize);
          const rawR = Math.round((my - offsetY) / cellSize);

          if (rawC >= 0 && rawC < cols && rawR >= 0 && rawR < rows) {
            const freeCell = getClosestFreeCell(rawC, rawR);
            if (freeCell) {
              const { c, r } = freeCell;
              if (!hoverTarget || hoverTarget.c !== c || hoverTarget.r !== r) {
                hoverTarget = { c, r };
                target = { c, r };
                const res = solveBFS(start, target);
                if (res.path.length > 0) {
                  shortestPath = res.path;
                  exploredNodes = [];
                  exploreIndex = 0;
                  pathLengthDrawn = shortestPath.length;
                  runnerPos = 0;
                  state = "RUNNER";
                  stateTime = performance.now();
                  isHovered = true;
                }
              }
            }
          }
        });

        card.addEventListener("mouseleave", () => {
          isHovered = false;
          hoverTarget = null;
        });
      }

      function drawObstacle(p, item, isLight) {
        if (!item) return;
        ctx.save();
        if (item.type === "tree") {
          if (item.variant === 0) {
            // Pine tree (cây thông)
            ctx.fillStyle = isLight ? "rgba(120, 80, 50, 0.7)" : "rgba(160, 110, 70, 0.5)";
            ctx.fillRect(p.x - 0.75, p.y + 1, 1.5, 3.5);

            // Tier 1 (bottom)
            ctx.fillStyle = isLight ? "rgba(22, 101, 52, 0.75)" : "rgba(16, 185, 129, 0.5)";
            ctx.beginPath();
            ctx.moveTo(p.x, p.y - 4);
            ctx.lineTo(p.x + 3.8, p.y + 1.8);
            ctx.lineTo(p.x - 3.8, p.y + 1.8);
            ctx.closePath();
            ctx.fill();

            // Tier 2 (top)
            ctx.fillStyle = isLight ? "rgba(34, 197, 94, 0.85)" : "rgba(52, 211, 153, 0.65)";
            ctx.beginPath();
            ctx.moveTo(p.x, p.y - 6);
            ctx.lineTo(p.x + 2.8, p.y - 1);
            ctx.lineTo(p.x - 2.8, p.y - 1);
            ctx.closePath();
            ctx.fill();
          } else {
            // Round canopy tree (cây tán tròn)
            ctx.fillStyle = isLight ? "rgba(120, 80, 50, 0.7)" : "rgba(160, 110, 70, 0.5)";
            ctx.fillRect(p.x - 0.75, p.y + 1, 1.5, 3.5);

            ctx.fillStyle = isLight ? "rgba(34, 197, 94, 0.7)" : "rgba(34, 197, 94, 0.5)";
            ctx.beginPath();
            ctx.arc(p.x, p.y - 1.5, 4, 0, Math.PI * 2);
            ctx.fill();

            // Foliage highlight
            ctx.fillStyle = isLight ? "rgba(74, 222, 128, 0.8)" : "rgba(110, 231, 183, 0.65)";
            ctx.beginPath();
            ctx.arc(p.x - 1, p.y - 2.5, 1.6, 0, Math.PI * 2);
            ctx.fill();
          }
        } else {
          // Rock (cục đá)
          if (item.variant === 0) {
            // Faceted boulder (tảng đá góc cạnh)
            ctx.fillStyle = isLight ? "rgba(100, 116, 139, 0.55)" : "rgba(148, 163, 184, 0.45)";
            ctx.beginPath();
            ctx.moveTo(p.x - 3.5, p.y + 2.5);
            ctx.lineTo(p.x - 2.8, p.y - 1.8);
            ctx.lineTo(p.x + 1.2, p.y - 3.2);
            ctx.lineTo(p.x + 3.8, p.y - 0.5);
            ctx.lineTo(p.x + 3.0, p.y + 2.8);
            ctx.closePath();
            ctx.fill();

            // Light facet
            ctx.fillStyle = isLight ? "rgba(148, 163, 184, 0.5)" : "rgba(203, 213, 225, 0.6)";
            ctx.beginPath();
            ctx.moveTo(p.x - 2.8, p.y - 1.8);
            ctx.lineTo(p.x + 1.2, p.y - 3.2);
            ctx.lineTo(p.x + 0.2, p.y + 0.2);
            ctx.lineTo(p.x - 3.5, p.y + 2.5);
            ctx.closePath();
            ctx.fill();
          } else {
            // Twin pebbles (cặp đá nhỏ)
            ctx.fillStyle = isLight ? "rgba(113, 113, 122, 0.55)" : "rgba(161, 161, 170, 0.45)";
            ctx.beginPath();
            ctx.ellipse(p.x - 1.6, p.y + 0.8, 3, 2.2, -0.2, 0, Math.PI * 2);
            ctx.fill();

            ctx.fillStyle = isLight ? "rgba(161, 161, 170, 0.65)" : "rgba(212, 212, 216, 0.6)";
            ctx.beginPath();
            ctx.ellipse(p.x + 2.2, p.y + 1.4, 2.2, 1.6, 0.3, 0, Math.PI * 2);
            ctx.fill();
          }
        }
        ctx.restore();
      }

      function draw() {
        if (!isVisible) {
          animId = requestAnimationFrame(draw);
          return;
        }

        const now = performance.now();
        const primaryHex = getPrimaryColor();
        const [pr, pg, pb] = getRgb(primaryHex);
        const isLight = document.documentElement.dataset.uiTheme === "light";

        ctx.clearRect(0, 0, width, height);

        // 1. Draw subtle background grid lines
        ctx.lineWidth = 1;
        ctx.strokeStyle = isLight
          ? "rgba(76, 57, 51, 0.04)"
          : "rgba(255, 255, 255, 0.02)";
        ctx.beginPath();
        for (let c = 0; c < cols; c++) {
          const p1 = pos(c, 0);
          const p2 = pos(c, rows - 1);
          ctx.moveTo(p1.x, p1.y);
          ctx.lineTo(p2.x, p2.y);
        }
        for (let r = 0; r < rows; r++) {
          const p1 = pos(0, r);
          const p2 = pos(cols - 1, r);
          ctx.moveTo(p1.x, p1.y);
          ctx.lineTo(p2.x, p2.y);
        }
        ctx.stroke();

        // 2. Draw subtle grid node dots & obstacles (trees & rocks)
        const dotColor = isLight
          ? "rgba(76, 57, 51, 0.16)"
          : "rgba(255, 255, 255, 0.1)";

        for (let c = 0; c < cols; c++) {
          for (let r = 0; r < rows; r++) {
            const p = pos(c, r);
            const obstacle = obstacles.get(key(c, r));

            if (obstacle) {
              drawObstacle(p, obstacle, isLight);
            } else {
              ctx.fillStyle = dotColor;
              ctx.beginPath();
              ctx.arc(p.x, p.y, 1.2, 0, Math.PI * 2);
              ctx.fill();
            }
          }
        }

        // 3. State Machine Progression
        if (state === "SEARCHING") {
          // Progressively reveal wave of explored nodes
          const speed = 2; // nodes per frame
          exploreIndex = Math.min(exploredNodes.length, exploreIndex + speed);

          // Draw explored frontier nodes
          for (let i = 0; i < exploreIndex; i++) {
            const n = exploredNodes[i];
            const p = pos(n.c, n.r);
            const age = exploreIndex - i;
            const alpha = Math.max(0.04, 0.35 - age * 0.015);
            ctx.fillStyle = `rgba(${pr}, ${pg}, ${pb}, ${alpha * 0.7})`;
            ctx.beginPath();
            ctx.arc(p.x, p.y, 2, 0, Math.PI * 2);
            ctx.fill();
          }

          if (exploreIndex >= exploredNodes.length) {
            state = "PATH_DRAW";
            pathLengthDrawn = 0;
            stateTime = now;
          }
        }

        if (state === "PATH_DRAW") {
          // Draw shortest path progressively
          pathLengthDrawn = Math.min(
            shortestPath.length,
            pathLengthDrawn + 0.8
          );
          if (pathLengthDrawn >= shortestPath.length) {
            state = "RUNNER";
            runnerPos = 0;
            stateTime = now;
          }
        }

        if (state === "RUNNER") {
          // Move traveling beam along the path
          runnerPos += 0.045;
          if (runnerPos >= 1) {
            runnerPos = 1;
            state = "HOLD";
            stateTime = now;
            rippleR = 3;
            rippleAlpha = 0.9;
          }
        }

        if (state === "HOLD") {
          // Ripple expansion
          if (rippleAlpha > 0.01) {
            rippleR += 0.5;
            rippleAlpha *= 0.92;
          }

          if (!isHovered && now - stateTime > holdDuration) {
            state = "FADING";
            stateTime = now;
          }
        }

        if (state === "FADING") {
          const progress = (now - stateTime) / 350;
          fadeAlpha = Math.max(0, 1 - progress);
          if (progress >= 1) {
            startNewJourney(false);
          }
        }

        // 4. Draw Shortest Path Line
        if (
          (state === "PATH_DRAW" ||
            state === "RUNNER" ||
            state === "HOLD" ||
            state === "FADING") &&
          shortestPath.length > 1
        ) {
          const count =
            state === "PATH_DRAW"
              ? Math.floor(pathLengthDrawn)
              : shortestPath.length;

          if (count > 1) {
            ctx.save();
            ctx.globalAlpha = fadeAlpha;
            ctx.lineWidth = 2;
            ctx.strokeStyle = `rgba(${pr}, ${pg}, ${pb}, 0.85)`;
            ctx.shadowColor = `rgba(${pr}, ${pg}, ${pb}, 0.6)`;
            ctx.shadowBlur = 6;
            ctx.lineJoin = "round";
            ctx.lineCap = "round";

            ctx.beginPath();
            const pStart = pos(shortestPath[0].c, shortestPath[0].r);
            ctx.moveTo(pStart.x, pStart.y);

            for (let i = 1; i < count; i++) {
              const pt = pos(shortestPath[i].c, shortestPath[i].r);
              ctx.lineTo(pt.x, pt.y);
            }

            // Fraction to next node in PATH_DRAW
            if (state === "PATH_DRAW" && count < shortestPath.length) {
              const frac = pathLengthDrawn - count;
              const pCurr = pos(
                shortestPath[count - 1].c,
                shortestPath[count - 1].r
              );
              const pNext = pos(
                shortestPath[count].c,
                shortestPath[count].r
              );
              ctx.lineTo(
                pCurr.x + (pNext.x - pCurr.x) * frac,
                pCurr.y + (pNext.y - pCurr.y) * frac
              );
            }
            ctx.stroke();

            // Highlight path nodes
            ctx.fillStyle = `rgba(${pr}, ${pg}, ${pb}, 0.9)`;
            for (let i = 0; i < count; i++) {
              const pt = pos(shortestPath[i].c, shortestPath[i].r);
              ctx.beginPath();
              ctx.arc(pt.x, pt.y, 2.5, 0, Math.PI * 2);
              ctx.fill();
            }
            ctx.restore();
          }

          // 5. Draw Traveling Energy Beam (Runner)
          if (state === "RUNNER" && shortestPath.length > 1) {
            const totalSegments = shortestPath.length - 1;
            const floatIdx = runnerPos * totalSegments;
            const segIdx = Math.min(
              totalSegments - 1,
              Math.floor(floatIdx)
            );
            const segFrac = floatIdx - segIdx;
            const pA = pos(shortestPath[segIdx].c, shortestPath[segIdx].r);
            const pB = pos(
              shortestPath[segIdx + 1].c,
              shortestPath[segIdx + 1].r
            );
            const rx = pA.x + (pB.x - pA.x) * segFrac;
            const ry = pA.y + (pB.y - pA.y) * segFrac;

            ctx.save();
            ctx.globalAlpha = fadeAlpha;
            ctx.shadowColor = `rgba(${pr}, ${pg}, ${pb}, 1)`;
            ctx.shadowBlur = 10;
            ctx.fillStyle = isLight ? "#ffffff" : "#ffffff";
            ctx.beginPath();
            ctx.arc(rx, ry, 3.5, 0, Math.PI * 2);
            ctx.fill();
            ctx.restore();
          }
        }

        // 6. Draw Start & Target Nodes
        if (shortestPath.length > 0) {
          const pS = pos(start.c, start.r);
          const pT = pos(target.c, target.r);

          ctx.save();
          ctx.globalAlpha = fadeAlpha;

          // Start node (A)
          ctx.fillStyle = `rgba(${pr}, ${pg}, ${pb}, 0.9)`;
          ctx.shadowColor = `rgba(${pr}, ${pg}, ${pb}, 0.7)`;
          ctx.shadowBlur = 6;
          ctx.beginPath();
          ctx.arc(pS.x, pS.y, 3.5, 0, Math.PI * 2);
          ctx.fill();

          // Target node (B) with pulsing outer ring
          const breath = 0.5 + 0.5 * Math.sin(now * 0.005);
          ctx.fillStyle = `rgba(${pr}, ${pg}, ${pb}, 1)`;
          ctx.beginPath();
          ctx.arc(pT.x, pT.y, 3.5, 0, Math.PI * 2);
          ctx.fill();

          ctx.strokeStyle = `rgba(${pr}, ${pg}, ${pb}, ${0.3 + breath * 0.4})`;
          ctx.lineWidth = 1.2;
          ctx.beginPath();
          ctx.arc(pT.x, pT.y, 5.5 + breath * 2, 0, Math.PI * 2);
          ctx.stroke();

          // Ripple on arrival
          if (rippleAlpha > 0.01) {
            ctx.strokeStyle = `rgba(${pr}, ${pg}, ${pb}, ${rippleAlpha})`;
            ctx.lineWidth = 1.5;
            ctx.beginPath();
            ctx.arc(pT.x, pT.y, rippleR, 0, Math.PI * 2);
            ctx.stroke();
          }

          ctx.restore();
        }

        animId = requestAnimationFrame(draw);
      }

      // Intersection Observer to pause when off-screen
      if (typeof IntersectionObserver !== "undefined") {
        intersectionObserver = new IntersectionObserver((entries) => {
          for (const entry of entries) {
            isVisible = entry.isIntersecting;
          }
        });
        intersectionObserver.observe(canvas);
      }

      // Resize Observer
      if (typeof ResizeObserver !== "undefined") {
        resizeObserver = new ResizeObserver(() => {
          resize();
        });
        resizeObserver.observe(container);
      } else {
        window.addEventListener("resize", resize);
      }

      resize();
      animId = requestAnimationFrame(draw);
    }

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", init);
    } else {
      init();
    }

    document.addEventListener("astro:before-swap", () => {
      if (animId) cancelAnimationFrame(animId);
      if (resizeObserver) resizeObserver.disconnect();
      if (intersectionObserver) intersectionObserver.disconnect();
    });

    document.addEventListener("astro:page-load", () => {
      if (animId) cancelAnimationFrame(animId);
      const container = document.querySelector(".visit-card-bg");
      if (container) {
        const canvas = container.querySelector(".journey-path-canvas");
        if (canvas) canvas.dataset.initialized = "false";
      }
      init();
    });
  })();
</script>
