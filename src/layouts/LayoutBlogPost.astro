---
import { formatDate } from "../lib/helpers";
import BackLink from "../components/BackLink.astro";
import ShareSection from "../components/Blog/ShareSection.astro";
import AudioPlayer from "../components/Blog/AudioPlayer.astro";
import VideoCard from "../components/Blog/VideoCard.astro";
import BlogComments from "../components/Blog/BlogComments";
import BasicLayout from "./BasicLayout.astro";
import type { BlogLang } from "../lib/blog-lang";
import { SITE } from "../site-config";

type Props = {
  description: string;
  url: string;
  image?: string;
  enHref?: string | undefined;
  viHref?: string | undefined;
  translations: {
    lang: BlogLang;
    title: string;
    pubDate: Date;
    minutesRead: string;
  }[];
};

const { description, url, image, enHref, viHref, translations } = Astro.props;

const hasTranslation = Boolean(enHref && viHref);
---

<BasicLayout
  description={description}
  page="blog"
  slug={url}
  image={image}
  title={translations[0]?.title || ""}
  pubDate={translations[0]?.pubDate?.toISOString()}
  showSearch={false}
  navLabel="Blog"
>
  <main
    class="mx-auto max-w-3xl w-full min-h-screen px-3.5 sm:px-8 py-6 sm:py-8 text-neutral-100"
  >
    <VideoCard />
    {
      translations.map((translation, index) => {
        const isVietnamese = translation.lang === "vi";
        const dateLocale = isVietnamese ? "vi-VN" : "en-US";
        const authorLabel = isVietnamese ? "Viết bởi" : "Written by";
        const publishedLabel = isVietnamese ? "Xuất bản" : "Published";
        const readingLabel = isVietnamese ? "Thời gian đọc" : "Reading time";
        const displayReadingTime = isVietnamese
          ? translation.minutesRead
            ? translation.minutesRead.replace(
                /(\d+)\s*min(?:s)?\s*read/i,
                "~$1 phút đọc",
              )
            : "5 phút đọc"
          : translation.minutesRead;

        return (
          <div
            class="my-6 sm:my-10"
            data-blog-language={translation.lang}
            hidden={index > 0}
          >
            <h1
              class="text-2xl sm:text-4xl md:text-5xl font-bold tracking-tight"
              data-blog-title
              data-document-title={translation.title}
            >
              {translation.title}
            </h1>
            <div class="blog-meta-panel mt-6 flex flex-wrap items-center gap-x-6 gap-y-4 rounded-xl border border-solid border-neutral-800 bg-neutral-900/70 px-4 py-4 text-sm">
              <div class="flex items-center gap-3">
                <img
                  src="https://avatars.githubusercontent.com/u/64247567"
                  alt={`Avatar of ${SITE.author.fullName}`}
                  class="h-10 w-10 rounded-full object-cover"
                  width="40"
                  height="40"
                  loading="lazy"
                />
                <div>
                  <p class="m-0 text-xs text-neutral-400">{authorLabel}</p>
                  <p class="m-0 font-medium text-neutral-100">
                    {SITE.author.fullName}
                  </p>
                </div>
              </div>
              <dl class="m-0 flex flex-wrap gap-x-6 gap-y-3 text-neutral-300">
                <div>
                  <dt class="text-xs text-neutral-500">{publishedLabel}</dt>
                  <dd class="m-0 mt-1">
                    <time datetime={translation.pubDate.toISOString()}>
                      {formatDate(translation.pubDate, dateLocale)}
                    </time>
                  </dd>
                </div>
                <div>
                  <dt class="text-xs text-neutral-500">{readingLabel}</dt>
                  <dd class="m-0 mt-1">{displayReadingTime}</dd>
                </div>
              </dl>
              <div class="basis-full sm:basis-auto sm:flex-1">
                <AudioPlayer
                  lang={translation.lang}
                  targetId={`blog-article-${translation.lang}`}
                />
              </div>
            </div>
          </div>
        );
      })
    }
    {
      translations.map((translation, index) => (
        <div data-blog-language={translation.lang} hidden={index > 0}>
          <article
            id={`blog-article-${translation.lang}`}
            class="blog-reading-content prose prose-slate prose-invert pb-8"
            data-tts-content
          >
            <slot name={translation.lang} />
            <ShareSection title={translation.title} lang={translation.lang} />
          </article>
          <BlogComments postSlug={url} lang={translation.lang} client:visible />
        </div>
      ))
    }
  </main>
</BasicLayout>

<script is:inline>
  (function () {
    try {
      var param = new URLSearchParams(window.location.search).get("lang");
      var stored = localStorage.getItem("portfolio:blog-lang");
      var selectedLang = param
        ? param === "vi"
          ? "vi"
          : "en"
        : stored === "vi"
          ? "vi"
          : "en";
      if (param) {
        localStorage.setItem("portfolio:blog-lang", selectedLang);
      }
      var elements = document.querySelectorAll("[data-blog-language]");
      var available = [];
      elements.forEach(function (el) {
        available.push(el.getAttribute("data-blog-language"));
      });
      if (available.length > 0 && available.indexOf(selectedLang) === -1) {
        selectedLang = available[0] || "en";
      }
      elements.forEach(function (el) {
        if (el.getAttribute("data-blog-language") === selectedLang) {
          el.removeAttribute("hidden");
        } else {
          el.setAttribute("hidden", "");
        }
      });
      var options = document.querySelectorAll(
        "[data-lang-toggle] [data-lang-option]",
      );
      options.forEach(function (option) {
        var isCurrent =
          option.getAttribute("data-lang-option") === selectedLang;
        option.setAttribute("data-active", isCurrent ? "true" : "false");
        option.setAttribute("aria-pressed", String(isCurrent));
        if (isCurrent) {
          option.setAttribute("aria-current", "page");
        } else {
          option.removeAttribute("aria-current");
        }
      });
      var titleEl = document.querySelector(
        '[data-blog-language="' + selectedLang + '"] [data-blog-title]',
      );
      if (titleEl && titleEl.getAttribute("data-document-title")) {
        document.title = titleEl.getAttribute("data-document-title");
      }
      document.documentElement.lang = selectedLang;
    } catch (e) {}
  })();
</script>

<script>
  import { BLOG_LANG_KEY } from "../lib/blog-lang";
  import { setupSpeechPlayers } from "../lib/speech-synthesis";

  function applyBlogLanguage(forcedLang?: "en" | "vi") {
    const param = new URLSearchParams(window.location.search).get("lang");
    const stored = localStorage.getItem(BLOG_LANG_KEY);
    let selectedLang: "en" | "vi" =
      forcedLang || (param === "vi" || stored === "vi" ? "vi" : "en");

    if (forcedLang) {
      localStorage.setItem(BLOG_LANG_KEY, forcedLang);
      const nextUrl = new URL(window.location.href);
      if (forcedLang === "vi") nextUrl.searchParams.set("lang", "vi");
      else nextUrl.searchParams.delete("lang");
      window.history.replaceState({}, "", nextUrl.toString());
    } else if (param) {
      localStorage.setItem(BLOG_LANG_KEY, selectedLang);
    }

    const availableElements = Array.from(
      document.querySelectorAll<HTMLElement>("[data-blog-language]"),
    );
    const availableLanguages = new Set(
      availableElements.map((el) => el.dataset.blogLanguage),
    );

    if (availableElements.length > 0 && !availableLanguages.has(selectedLang)) {
      selectedLang =
        availableElements[0]?.dataset.blogLanguage === "vi" ? "vi" : "en";
    }

    availableElements.forEach((element) => {
      element.hidden = element.dataset.blogLanguage !== selectedLang;
    });

    document
      .querySelectorAll<HTMLElement>("[data-lang-toggle] [data-lang-option]")
      .forEach((option) => {
        const isCurrent = option.dataset.langOption === selectedLang;
        option.dataset.active = isCurrent ? "true" : "false";
        option.setAttribute("aria-pressed", String(isCurrent));
        if (isCurrent) {
          option.setAttribute("aria-current", "page");
        } else {
          option.removeAttribute("aria-current");
        }
      });

    const title = document.querySelector<HTMLElement>(
      `[data-blog-language="${selectedLang}"] [data-blog-title]`,
    )?.dataset.documentTitle;
    if (title) document.title = title;
    document.documentElement.lang = selectedLang;
  }

  function setupBlogLanguageListeners() {
    applyBlogLanguage();

    document
      .querySelectorAll<HTMLElement>("[data-lang-toggle] [data-lang-option]")
      .forEach((option) => {
        option.addEventListener("click", () => {
          const lang = option.dataset.langOption;
          if (lang === "en" || lang === "vi") {
            applyBlogLanguage(lang);
          }
        });
      });

    window.addEventListener("blog-lang-change", (e: any) => {
      const lang = e.detail?.lang;
      if (lang === "en" || lang === "vi") {
        applyBlogLanguage(lang);
      }
    });

    setupSpeechPlayers();
    renderMermaidDiagrams();
  }

  async function renderMermaidDiagrams() {
    const mermaidNodes = document.querySelectorAll<HTMLElement>(
      'pre[data-language="mermaid"], pre.mermaid, code.language-mermaid'
    );
    if (mermaidNodes.length === 0) return;

    try {
      const dynamicImport = new Function("url", "return import(url)");
      const { default: mermaid } = await dynamicImport(
        "https://cdn.jsdelivr.net/npm/mermaid@11/dist/mermaid.esm.min.mjs"
      );
      mermaid.initialize({
        startOnLoad: false,
        theme: "dark",
        themeVariables: {
          darkMode: true,
          background: "#0f172a",
          primaryColor: "#0284c7",
          primaryTextColor: "#f1f5f9",
          primaryBorderColor: "#38bdf8",
          lineColor: "#94a3b8",
        },
      });

      const processed = new Set<HTMLElement>();

      for (let i = 0; i < mermaidNodes.length; i++) {
        const node = mermaidNodes[i];
        const pre = (node.tagName.toLowerCase() === "pre"
          ? node
          : node.closest("pre")) as HTMLElement | null;
        if (!pre || processed.has(pre)) continue;
        processed.add(pre);

        const code = pre.textContent?.trim() || "";
        if (!code) continue;

        try {
          const id = `mermaid-svg-${Date.now()}-${i}`;
          const { svg } = await mermaid.render(id, code);
          const container = document.createElement("div");
          container.className =
            "mermaid-diagram my-6 flex justify-center overflow-x-auto p-4 rounded-xl bg-neutral-900/60 border border-neutral-800";
          container.innerHTML = svg;
          pre.replaceWith(container);
        } catch (renderError) {
          console.warn("Failed to render Mermaid diagram:", renderError);
        }
      }
    } catch (loadError) {
      console.warn("Failed to load Mermaid library:", loadError);
    }
  }

  document.addEventListener("astro:page-load", setupBlogLanguageListeners);
  setupBlogLanguageListeners();
</script>

<style is:global>
  h1,
  h2,
  h3,
  h4,
  h5,
  h6 {
    margin-top: 20px;
    margin-bottom: 10px;
    font-weight: bold;
  }

  h1 {
    font-size: 32px;
  }

  h2 {
    font-size: 28px;
  }

  h3 {
    font-size: 24px;
  }

  h4 {
    font-size: 20px;
  }

  h5 {
    font-size: 18px;
  }

  h6 {
    font-size: 16px;
  }

  p {
    margin: 0 0 10px 0;
  }

  article a {
    color: var(--primary-400);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  a:hover {
    text-decoration: underline;
  }

  ul,
  ol {
    margin-left: 20px;
    margin-bottom: 10px;
  }

  blockquote {
    margin: 20px 0;
    padding-left: 15px;
    border-left: 5px solid #ccc;
  }

  article pre,
  article code {
    font-family: "Courier New", monospace;
    background-color: rgba(255, 255, 255, 0.06);
    border-radius: 5px;
  }

  pre {
    padding: 10px;
    overflow-x: auto;
  }

  article code {
    padding: 2px 4px;
    font-size: 90%;
    color: var(--primary-300);
  }

  img {
    max-width: 100%;
    height: auto;
  }

  table {
    border-collapse: collapse;
    width: 100%;
  }

  th,
  td {
    text-align: left;
    padding: 8px;
    border-bottom: 1px solid #ddd;
  }
</style>
