---
import "../style.css";
import { ClientRouter } from "astro:transitions";
import { LINKS } from "../lib/constants";
import { SITE } from "../site-config";
import GridTransition from "../components/GridTransition.astro";
import StylePanel from "../components/StylePanel.astro";
import { Navigation } from "../components/landing/navigation";
import { SubpageNavigation, type SubpageNavCta } from "../components/site/subpage-navigation";

interface Props {
  title: string;
  description: string;
  page?: "travel" | "blog";
  slug?: string | undefined;
  pubDate?: string;
  keywords?: string[];
  hideSoundToggle?: boolean;
  soundTogglePosition?: "left" | "right";
  noPadding?: boolean;
  hideCal?: boolean;
  navLabel?: string;
  navCta?: SubpageNavCta;
  hideHeader?: boolean;
  showSearch?: boolean;
  searchPlaceholder?: string;
  image?: string;
}

const {
  title,
  description,
  page,
  pubDate,
  keywords: propKeywords,
  hideSoundToggle,
  soundTogglePosition = "right",
  noPadding = false,
  hideCal,
  navLabel,
  navCta,
  hideHeader,
  showSearch,
  searchPlaceholder,
  image: propImage,
} = Astro.props;

const siteBaseUrl = Astro.site
  ? Astro.site.toString().replace(/\/+$/, "")
  : (SITE.site.url.endsWith("/") ? SITE.site.url.slice(0, -1) : SITE.site.url);
const canonicalUrl = new URL(Astro.url.pathname, siteBaseUrl).href;

let image = `${siteBaseUrl}/og.webp`;
if (propImage) {
  if (propImage.startsWith("http://") || propImage.startsWith("https://")) {
    image = propImage;
  } else {
    image = `${siteBaseUrl}${propImage.startsWith("/") ? "" : "/"}${propImage}`;
  }
}

const currentPath = Astro.url.pathname.replace(/\/$/, "") || "/";
const isHome = currentPath === "/";

const combinedKeywords = propKeywords
  ? Array.from(new Set([...propKeywords, ...(SITE.author.keywords || [])]))
  : (SITE.author.keywords || []);

const defaultLabelMap: Record<string, string> = {
  "/blog": "Blog",
  "/books": "Bookshelf",
  "/guestbook": "Guestbook",
  "/engineering-showcase": "Engineering Showcase",
  "/travel": "Travel",
  "/visit": "Visited Provinces",
  "/playground": "Playground",
  "/resume": "Resume / CV",
};

const pathSegments = currentPath.split("/").filter(Boolean);
const autoLabel = defaultLabelMap[currentPath] ||
  (currentPath.startsWith("/blog/") ? "Blog" : null) ||
  (pathSegments.length > 0
    ? pathSegments[pathSegments.length - 1].replace(/-/g, " ").toUpperCase()
    : "Subpage");

const resolvedNavLabel = navLabel || autoLabel;

const searchRoutes = ["/playground", "/books", "/engineering-showcase"];
const resolvedShowSearch =
  showSearch !== undefined
    ? showSearch
    : currentPath === "/blog" ||
      searchRoutes.some((r) => currentPath === r || currentPath.startsWith(`${r}/`));

const resolvedSearchPlaceholder =
  searchPlaceholder || `Search ${resolvedNavLabel.toLowerCase()}...`;

const breadcrumbItems = [
  {
    "@type": "ListItem",
    position: 1,
    name: "Home",
    item: siteBaseUrl,
  },
];

if (!isHome) {
  breadcrumbItems.push({
    "@type": "ListItem",
    position: 2,
    name: title,
    item: canonicalUrl,
  });
}

const personEntity = {
  "@type": "Person",
  "@id": `${siteBaseUrl}/#person`,
  name: SITE.author.fullNameVi,
  alternateName: SITE.author.alternateNames,
  givenName: "Quốc Việt",
  familyName: "Đỗ",
  additionalName: SITE.author.shortName,
  url: siteBaseUrl,
  sameAs: [
    LINKS.linkedin,
    LINKS.github,
    LINKS.twitter,
    LINKS.medium,
    LINKS.goodreads,
    "https://cal.com/vietdoo",
  ],
  image: "https://github.com/vietdoo.png",
  jobTitle: SITE.author.jobTitleFull || SITE.author.jobTitle,
  description: SITE.site.description || description,
  knowsAbout: SITE.author.keywords || [
    ...SITE.author.domains,
    ...SITE.author.coreTechnologies,
  ],
  worksFor: {
    "@type": "Organization",
    "@id": "https://vnpt.com.vn/#organization",
    name: SITE.author.companyVi,
    alternateName: SITE.author.companyAliases || [SITE.author.company, "VNPT"],
    url: "https://vnpt.com.vn",
    address: {
      "@type": "PostalAddress",
      addressLocality: SITE.location.locality || SITE.location.countryName,
      addressCountry: SITE.location.countryCode,
    },
  },
  alumniOf: {
    "@type": "EducationalOrganization",
    name: "VNU-HCM University of Science (Đại học Khoa học Tự nhiên - ĐHQG TP.HCM)",
    alternateName: ["HCMUS", "VNU-HCMUS", "ĐH KHTN"],
    url: "https://hcmus.edu.vn",
  },
  founder: {
    "@type": "Organization",
    name: "VNDO Platform",
    url: "https://vndo.vn",
  },
  address: {
    "@type": "PostalAddress",
    addressLocality: SITE.location.locality || SITE.location.countryName,
    addressCountry: SITE.location.countryCode,
  },
  nationality: {
    "@type": "Country",
    name: SITE.location.countryName,
  },
};

const webSiteEntity = {
  "@type": "WebSite",
  "@id": `${siteBaseUrl}/#website`,
  url: siteBaseUrl,
  name: SITE.site.title,
  description: SITE.site.description,
  publisher: { "@id": `${siteBaseUrl}/#person` },
  inLanguage: ["en-US", "vi-VN"],
};

const webPageEntity = isHome
  ? {
      "@type": "ProfilePage",
      "@id": `${siteBaseUrl}/#webpage`,
      url: siteBaseUrl,
      name: title,
      description: description,
      mainEntity: { "@id": `${siteBaseUrl}/#person` },
      isPartOf: { "@id": `${siteBaseUrl}/#website` },
      inLanguage: ["en-US", "vi-VN"],
    }
  : {
      "@type": page === "blog" ? "ItemPage" : "WebPage",
      "@id": canonicalUrl,
      url: canonicalUrl,
      name: title,
      description: description,
      isPartOf: { "@id": `${siteBaseUrl}/#website` },
      about: { "@id": `${siteBaseUrl}/#person` },
      author: { "@id": `${siteBaseUrl}/#person` },
      inLanguage: "en-US",
    };

const breadcrumbEntity = {
  "@type": "BreadcrumbList",
  "@id": `${canonicalUrl}#breadcrumb`,
  itemListElement: breadcrumbItems,
};

const graphNodes: any[] = [personEntity, webSiteEntity, webPageEntity, breadcrumbEntity];

if (page === "blog") {
  graphNodes.push({
    "@type": "BlogPosting",
    "@id": `${canonicalUrl}#article`,
    mainEntityOfPage: { "@id": canonicalUrl },
    headline: title,
    description: description,
    image: image,
    author: { "@id": `${siteBaseUrl}/#person` },
    publisher: { "@id": `${siteBaseUrl}/#person` },
    datePublished: pubDate || new Date().toISOString(),
    dateModified: pubDate || new Date().toISOString(),
    isPartOf: { "@id": `${siteBaseUrl}/#website` },
    inLanguage: "en-US",
  });
}

const jsonLdGraph = {
  "@context": "https://schema.org",
  "@graph": graphNodes,
};
---

<!doctype html>
<html
  lang="en"
  data-cal-namespace={SITE.cal.durationNamespace}
  data-cal-origin={SITE.cal.origin}
>
  <head>
    <meta charset="UTF-8" />
    <ClientRouter />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" hreflang="en" href={canonicalUrl} />
    <link rel="alternate" hreflang="vi" href={canonicalUrl} />
    <link rel="alternate" hreflang="x-default" href={canonicalUrl} />
    <link rel="icon" type="image/png" href="/icon-dark-32x32.png" media="(prefers-color-scheme: dark)" />
    <link rel="icon" type="image/png" href="/icon-light-32x32.png" media="(prefers-color-scheme: light)" />
    <link rel="icon" type="image/png" href="/vndo.png" />
    <link rel="apple-touch-icon" href="/apple-icon.png" />
    <meta name="apple-mobile-web-app-title" content={SITE.author.fullNameVi} />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="alternate" type="application/rss+xml" title={`${SITE.author.fullNameVi} RSS Feed`} href="/rss.xml" />
    <meta content={Astro.generator} name="generator" />
    <title>{title}</title>
    <meta content={description} name="description" />
    <meta content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" name="robots" />
    <meta name="theme-color" content="#171717" />
    <script is:inline>
      (() => {
        try {
          const theme = localStorage.getItem("portfolio:ui-mode") === "light" ? "light" : "dark";
          document.documentElement.dataset.uiTheme = theme;
          document.documentElement.style.colorScheme = theme;
          document.querySelector('meta[name="theme-color"]')?.setAttribute("content", theme === "light" ? "#e8dfd0" : "#171717");
        } catch {
          document.documentElement.dataset.uiTheme = "dark";
        }
      })();
    </script>
    <meta name="author" content={`${SITE.author.fullNameVi} (${SITE.author.shortName})`} />
    <meta
      name="keywords"
      content={combinedKeywords.join(", ")}
    />
    <meta
      content={page === "blog" ? "article" : "website"}
      property="og:type"
    />
    <meta content={title} property="og:title" />
    <meta content={description} property="og:description" />
    <meta content={canonicalUrl} property="og:url" />
    <meta property="og:site_name" content={SITE.author.fullNameVi} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:locale:alternate" content="vi_VN" />
    <meta
      content={image}
      property="og:image"
    />
    <meta property="og:image:alt" content={description} />
    <meta property="og:image:type" content="image/webp" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta content="summary_large_image" name="twitter:card" />
    <meta content={title} name="twitter:title" />
    <meta content={description} name="twitter:description" />
    <meta name="twitter:site" content={`@${SITE.author.twitterHandle}`} />
    <meta name="twitter:creator" content={`@${SITE.author.twitterHandle}`} />
    <meta
      content={image}
      name="twitter:image"
    />

    <script
      is:inline
      set:html={JSON.stringify(jsonLdGraph)}
      type="application/ld+json"
    />
    <script
      defer
      is:inline
      src="https://cloud.umami.is/script.js"
      data-website-id={import.meta.env.UMAMI_WEBSITE_ID}
      data-domains="vndo.vn"></script>
    <script
      src="https://analytics.ahrefs.com/analytics.js"
      data-key={import.meta.env.AHREFS_ANALYTICS_KEY}
      async></script>

    <!-- Cal element-click embed code begins -->
    {!hideCal && <script is:inline type="text/javascript">
      (function (C, A, L) {
        let p = function (a, ar) {
          a.q.push(ar);
        };
        let d = C.document;
        C.Cal =
          C.Cal ||
          function () {
            let cal = C.Cal;
            let ar = arguments;
            if (!cal.loaded) {
              cal.ns = {};
              cal.q = cal.q || [];
              d.head.appendChild(d.createElement("script")).src = A;
              cal.loaded = true;
            }
            if (ar[0] === L) {
              const api = function () {
                p(api, arguments);
              };
              const namespace = ar[1];
              api.q = api.q || [];
              if (typeof namespace === "string") {
                cal.ns[namespace] = cal.ns[namespace] || api;
                p(cal.ns[namespace], ar);
                p(cal, ["initNamespace", namespace]);
              } else p(cal, ar);
              return;
            }
            p(cal, ar);
          };
      })(window, "https://app.cal.com/embed/embed.js", "init");
      const calNamespace =
        document.documentElement.dataset.calNamespace || "15min";
      const calOrigin =
        document.documentElement.dataset.calOrigin || "https://cal.com";

      Cal("init", calNamespace, { origin: calOrigin });

      Cal.ns[calNamespace]("ui", {
        styles: { branding: { brandColor: "#000000" } },
        hideEventTypeDetails: false,
        layout: "month_view",
      });
    </script>}
    <!-- Cal element-click embed code ends -->
  </head>
  <body data-route={currentPath} class="bg-darkslate-700 flex flex-col justify-start items-center min-h-screen w-full">
    <GridTransition />
    <slot name="loader" />
    {
      !hideHeader && isHome && <Navigation client:load />
    }
    {
      !hideHeader && !isHome && (
        <SubpageNavigation
          client:load
          label={resolvedNavLabel}
          cta={navCta}
          showSearch={resolvedShowSearch}
          searchPlaceholder={resolvedSearchPlaceholder}
          showLangToggle={page === "blog" || currentPath.startsWith("/blog")}
        />
      )
    }
    <div class={!hideHeader && !noPadding ? "w-full flex-1 flex flex-col items-center relative overflow-hidden pt-20 lg:pt-24" : "w-full flex-1 flex flex-col items-center relative overflow-hidden"}>
      <slot />
    </div>
    {/* 
      LƯU Ý DÀNH CHO AI AGENT:
      Hai nút floating bên dưới (StylePanel và sound-toggle) đã được tạm ẩn trên toàn hệ thống theo yêu cầu của người dùng.
      CHỈ ĐƯỜC PHÉP BẬT/MỞ LẠI KHI CÓ YÊU CẦU TRỰC TIẾP VÀ RÕ RÀNG TỪ NGƯỜI DÙNG (USER).
      
      !hideSoundToggle && (
        <div class={`fixed bottom-4 md:bottom-6 z-50 flex flex-col items-center gap-2 ${soundTogglePosition === "left" ? "left-4 md:left-6" : "right-4 md:right-6"}`}>
          <StylePanel />
          <button
            id="sound-toggle"
            aria-label="Toggle sound"
            title="Toggle sound"
            class="w-9 h-9 flex items-center justify-center rounded-lg bg-darkslate-500 border border-darkslate-400 hover:border-primary-500 transition-all duration-200 text-white shadow-lg"
          >
            <svg
              id="sound-icon-on"
              xmlns="http://www.w3.org/2000/svg"
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5" />
              <path d="M19.07 4.93a10 10 0 0 1 0 14.14" />
              <path d="M15.54 8.46a5 5 0 0 1 0 7.07" />
            </svg>
            <svg
              id="sound-icon-off"
              xmlns="http://www.w3.org/2000/svg"
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="hidden"
            >
              <polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5" />
              <line x1="23" y1="9" x2="17" y2="15" />
              <line x1="17" y1="9" x2="23" y2="15" />
            </svg>
          </button>
        </div>
      )
    */}
  </body>
</html>

<script>
  let audioCtx: AudioContext | null = null;
  let soundEnabled = localStorage.getItem("soundEnabled") !== "false";

  function getAudioCtx(): AudioContext {
    if (!audioCtx) audioCtx = new AudioContext();
    if (audioCtx.state === "suspended") audioCtx.resume();
    return audioCtx;
  }

  function playCardHover() {
    if (!soundEnabled) return;
    const ctx = getAudioCtx();
    const osc = ctx.createOscillator();
    const gain = ctx.createGain();
    osc.connect(gain);
    gain.connect(ctx.destination);
    osc.type = "sine";
    osc.frequency.setValueAtTime(1100, ctx.currentTime);
    osc.frequency.exponentialRampToValueAtTime(500, ctx.currentTime + 0.018);
    gain.gain.setValueAtTime(0.12, ctx.currentTime);
    gain.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + 0.018);
    osc.start(ctx.currentTime);
    osc.stop(ctx.currentTime + 0.018);
  }

  function updateToggleIcon() {
    document
      .getElementById("sound-icon-on")
      ?.classList.toggle("hidden", !soundEnabled);
    document
      .getElementById("sound-icon-off")
      ?.classList.toggle("hidden", soundEnabled);
  }

  function attachCardSounds() {
    document.querySelectorAll<HTMLElement>(".card").forEach((card) => {
      card.removeEventListener("mouseenter", playCardHover);
      card.addEventListener("mouseenter", playCardHover);
    });

    document.getElementById("sound-toggle")?.addEventListener("click", () => {
      soundEnabled = !soundEnabled;
      localStorage.setItem("soundEnabled", String(soundEnabled));
      updateToggleIcon();
    });
  }

  document.addEventListener("astro:page-load", () => {
    soundEnabled = localStorage.getItem("soundEnabled") !== "false";
    updateToggleIcon();
    attachCardSounds();
  });

  console.log(
    "%c\n" +
      "  .-. (  ) .-.   .-. (  ) .-.   .-.\n" +
      " (* *)( ** )* *) (* *)( ** )(* *) (* *)\n" +
      "  `-'  `--' `-'   `-'  `--' `-'   `-'\n" +
      "   |    |    |     |    |    |     |\n" +
      "   |    |    |     |    |    |     |\n" +
      "---+----+----+-----+----+----+-----+---\n" +
      " ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~\n" +
      "   ~    ~    ~     ~    ~    ~     ~\n",
    "color:var(--primary-500);font-family:monospace;font-size:11px;line-height:1.5;",
  );
  console.log(
    "%cMate, what are you looking for here? 😄",
    "color:var(--primary-400);font-size:15px;font-weight:bold;",
  );
  console.log(
    "%cJust send me a message, I'd love to connect.\n",
    "color:var(--darkslate-200);font-size:12px;",
  );
  console.log(
    "%c💼  linkedin.com/in/vietdoo\n📧  vietdoo@outlook.com",
    "color:var(--primary-300);font-size:12px;line-height:2;",
  );
</script>

<script>
  import {
    PORTFOLIO_HAS_VISITED_NON_HOME_KEY,
    PORTFOLIO_LAST_PATH_KEY,
    normalizePathname,
  } from "../lib/nav-path";

  if (typeof document !== "undefined") {
    document.addEventListener("astro:page-load", () => {
      const uiTheme = localStorage.getItem("portfolio:ui-mode") === "light" ? "light" : "dark";
      document.documentElement.dataset.uiTheme = uiTheme;
      document.documentElement.style.colorScheme = uiTheme;
      document.querySelector('meta[name="theme-color"]')?.setAttribute("content", uiTheme === "light" ? "#e8dfd0" : "#171717");

      const theme = localStorage.getItem("theme");
      if (theme && theme !== "default") {
        document.body.classList.add(theme);
      }

      const loader = document.querySelector(".loader");
      if (loader instanceof HTMLElement) {
        loader.style.opacity = "0";
        loader.style.pointerEvents = "none";
      }

      const path = normalizePathname(window.location.pathname);
      if (path !== "/") {
        sessionStorage.setItem(PORTFOLIO_HAS_VISITED_NON_HOME_KEY, "1");
      }

      queueMicrotask(() => {
        sessionStorage.setItem(PORTFOLIO_LAST_PATH_KEY, path);
      });
    });
  }
</script>

<style is:global>
  body {
    margin: 0;
    font-family: var(--font-satoshi), "Inter", "Be Vietnam Pro", sans-serif;
    -webkit-font-smoothing: antialiased;
  }

  h1,
  h2,
  h3,
  h4,
  h5,
  h6 {
    font-family: var(--font-cabinet-grotesk), "Plus Jakarta Sans", "Be Vietnam Pro", sans-serif;
  }
  p {
    font-family: var(--font-satoshi), "Inter", "Be Vietnam Pro", sans-serif;
  }

  b {
    font-weight: 700 !important;
  }

  @supports (view-transition-name: none) {
    ::view-transition-old(root),
    ::view-transition-new(root) {
      animation-duration: 320ms;
      animation-timing-function: cubic-bezier(0.22, 1, 0.36, 1);
    }
  }
</style>
