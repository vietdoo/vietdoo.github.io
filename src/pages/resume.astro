---
import Layout from "../layouts/Layout.astro";
import LoaderAnimation from "../components/LoaderAnimation.astro";
import { SITE } from "../site-config";
import { Icon } from "astro-icon/components";

const resumeData = {
  header: {
    name: SITE.author.fullNameVi,
    nameEn: SITE.author.fullName,
    title: SITE.author.jobTitleFull,
    location: "Ho Chi Minh City, Vietnam (GMT+7)",
    email: SITE.links.email,
    github: SITE.links.github,
    linkedin: SITE.links.linkedin,
    website: SITE.site.url,
  },
  summary:
    `Data & Software Engineer with ${SITE.author.yearsOfExperience} YOE specializing in high-performance backend systems, Big Data pipelines, cloud-native microservices, and AI agent architectures. Currently engineering the National Public Service Portal at VNPT, serving millions of citizens nationwide.`,
  experience: [
    {
      period: "Dec 2024 — Present",
      role: "Software Engineer",
      company: "VNPT Group (Vietnam Posts and Telecommunications Group)",
      location: "Ho Chi Minh City, Vietnam",
      highlights: [
        "Architecting and optimizing high-throughput microservices for the Vietnam National Public Service Portal (Cổng Dịch vụ công Quốc gia).",
        "Ensuring system resilience, ultra-low latency, and high availability for mission-critical e-Government public administrative procedures.",
        "Engineering scalable REST microservices with Spring Boot, FastAPI, Redis, Apache Kafka, Docker, and Kubernetes.",
      ],
    },
    {
      period: "2024 — Present",
      role: "Founder & Lead Architect",
      company: "VNDO SaaS Platform",
      location: "Ho Chi Minh City, Vietnam",
      highlights: [
        "Founded VNDO (vndo.vn), a modern website-building and web ecosystem platform operating across 5 global points of presence (Hanoi, HCMC, Da Nang, Singapore, US).",
        "Built global multi-region edge deployment pipeline with <50ms response latency and targeting 99.99% uptime.",
        "Developed specialized sub-products including Public Service Lookups (hosodichvucong.online), Document Management (vanban.hosodichvucong.online), Kiosk CHCC (kiosk-hcc.hosodichvucong.online), and Social Trend Analytics (diemtrend.vietdoo.site).",
      ],
    },
    {
      period: "Mar 2023 — Feb 2024",
      role: "Data Engineer",
      company: "Embery Digital Agency",
      location: "Melbourne, Australia / Remote",
      highlights: [
        "Engineered automated, high-volume ETL data workflows ingesting structured and unstructured data from hundreds of disparate client sources.",
        "Incorporated machine learning models into data processing pipelines to automate image analysis and computer vision scoring.",
        "Exposed custom trend-analysis APIs and analytics dashboards for digital intelligence platforms.",
      ],
    },
  ],
  education: [
    {
      period: "2020 — 2024",
      institution:
        "VNU-HCM University of Science (ĐH Khoa Học Tự Nhiên - ĐHQG TP.HCM)",
      degree: "Bachelor of Science in Data Science",
      details:
        "Graduated with High Honors (GPA: 3.5/4.0). Grounded in competitive programming, mathematical modeling, algorithm optimization, and distributed data systems.",
    },
  ],
  certifications: [
    {
      title: "Claude Code in Action",
      issuer: "Anthropic",
      date: "May 2026",
      id: "uxun2k7buozd",
    },
    {
      title: "Data Engineering, Big Data, & ML on GCP",
      issuer: "Google",
      date: "Sep 2022",
      id: "EZMZERSNG6UB",
    },
    {
      title: "IBM Data Engineering Professional Certificate",
      issuer: "IBM",
      date: "Aug 2022",
      id: "948G3Z9KNZ7C",
    },
    {
      title: "SQL (Advanced)",
      issuer: "HackerRank",
      date: "Mar 2022",
      id: "f586e92927c5",
    },
    {
      title: "Problem Solving (Intermediate)",
      issuer: "HackerRank",
      date: "Nov 2021",
      id: "ad708e2017db",
    },
    {
      title: "Neural Networks and Deep Learning",
      issuer: "DeepLearning.AI",
      date: "Sep 2021",
      id: "CR8RHMS5LT5P",
    },
    {
      title: "Machine Learning with Python",
      issuer: "IBM",
      date: "Aug 2021",
      id: "6RGVKBUBRC9D",
    },
    {
      title: "Google Cloud Certified",
      issuer: "Google",
      date: "Mar 2021",
      id: "Verified",
    },
  ],
  skills: [
    {
      category: "Languages",
      items: [
        "Python",
        "C++",
        "TypeScript",
        "SQL",
        "Shell",
        "Ruby",
        "HTML/CSS",
      ],
    },
    {
      category: "Backend & Web",
      items: [
        "Spring Boot",
        "FastAPI",
        "Flask",
        "Next.js",
        "SolidJS",
        "Astro",
        "Ruby on Rails",
      ],
    },
    {
      category: "Big Data & Streaming",
      items: [
        "Apache Spark",
        "Spark Streaming",
        "Apache Kafka",
        "Hadoop HDFS",
        "Apache Superset",
        "Redshift",
      ],
    },
    {
      category: "Databases & Caching",
      items: ["PostgreSQL", "Redis", "MongoDB", "SQLite3"],
    },
    {
      category: "Cloud & DevOps",
      items: [
        "Docker",
        "Kubernetes",
        "Linux (Ubuntu/Debian)",
        "Microservices",
        "CI/CD",
        "Vercel",
      ],
    },
    {
      category: "AI & Systems Architecture",
      items: [
        "AI Agent Architecture",
        "Handover Architecture",
        "LLM Fine-tuning",
        "OpenCV",
        "Z3 SMT Solver",
      ],
    },
  ],
  projects: [
    {
      name: "Vietnam National Public Service Portal",
      tech: "Spring Boot, FastAPI, Microservices, Redis, Kafka, Kubernetes",
      desc: "National digital transformation project providing public administrative services to millions of citizens.",
    },
    {
      name: "VNDO SaaS Platform & Ecosystem",
      tech: "Next.js, Multi-region Edge CDN, SolidJS, PostgreSQL",
      desc: "Website-building SaaS powering Hồ Sơ Dịch Vụ Công, Văn Bản HCC, Kiosk CHCC, and Điểm Trend.",
    },
    {
      name: "HCMC Houses Analysis Pipeline",
      tech: "HDFS, Apache Spark, Redshift, Apache Superset",
      desc: "Big Data analysis pipeline extracting and transforming 200k+ real estate listings for BI visualization.",
    },
    {
      name: "Binance Real-Time Volume Streaming",
      tech: "Apache Kafka, Spark Streaming, WebSockets",
      desc: "Live stream ingestion and real-time volume metrics calculation for Binance cryptocurrency pairs.",
    },
    {
      name: "AI Agent Handover Architecture",
      tech: "Agentic Workflows, Handover Ledger, Claude / Codex",
      desc: "Standardized repo-level continuity pattern preventing context loss across multi-agent handovers.",
    },
  ],
};
---

<LoaderAnimation />

<Layout
  title={`${SITE.author.fullNameVi} (${SITE.author.shortName}) — Resume / Curriculum Vitae`}
  description={`Official Resume and Curriculum Vitae of ${SITE.author.fullNameVi} (${SITE.author.shortName}), Software Engineer @ VNPT & Founder @ VNDO.`}
  keywords={[
    "Do Quoc Viet resume",
    "Do Quoc Viet CV",
    "vietdoo resume",
    "vietdoo CV",
    "VNPT Software Engineer resume",
    "Software Engineer Vietnam CV",
  ]}
  hideSoundToggle={true}
>
  <main
    class="resume-page w-full max-w-4xl mx-auto px-4 sm:px-6 py-6 sm:py-10 text-darkslate-100 print:text-black print:bg-white print:max-w-none print:px-0 print:py-0"
  >
    <!-- Resume Document Sheet -->
    <div
      class="bg-darkslate-800/90 border border-darkslate-700/60 rounded-2xl p-6 sm:p-10 shadow-xl print:bg-transparent print:border-none print:p-0 print:shadow-none"
    >
      <!-- Candidate Header -->
      <header
        class="border-b border-darkslate-700/70 pb-6 mb-8 print:border-gray-300"
      >
        <div
          class="flex flex-col md:flex-row md:items-start justify-between gap-6"
        >
          <div>
            <h1
              class="text-2xl sm:text-3xl font-extrabold tracking-tight text-white print:text-black"
            >
              {resumeData.header.name}
            </h1>
            <p
              class="text-primary-400 font-medium text-sm sm:text-base mt-1.5 print:text-gray-800"
            >
              {resumeData.header.title}
            </p>
            <div
              class="flex items-center gap-1.5 text-xs text-darkslate-300 mt-2 print:text-gray-600"
            >
              <Icon
                name="ri:map-pin-line"
                class="w-4 h-4 text-primary-400/90 shrink-0 print:hidden"
              />
              <span>{resumeData.header.location}</span>
            </div>
          </div>

          <div
            class="grid grid-cols-1 sm:grid-cols-2 md:flex md:flex-col gap-2 text-xs text-darkslate-300 print:text-gray-700 shrink-0"
          >
            <a
              href={`mailto:${resumeData.header.email}`}
              class="inline-flex items-center gap-2 hover:text-primary-400 transition-colors"
            >
              <Icon
                name="ri:mail-line"
                class="w-4 h-4 text-primary-400/90 shrink-0 print:hidden"
              />
              <span class="truncate">{resumeData.header.email}</span>
            </a>
            <a
              href={resumeData.header.github}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 hover:text-primary-400 transition-colors"
            >
              <Icon
                name="ri:github-fill"
                class="w-4 h-4 text-primary-400/90 shrink-0 print:hidden"
              />
              <span class="truncate"
                >{resumeData.header.github.replace("https://", "")}</span
              >
            </a>
            <a
              href={resumeData.header.linkedin}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 hover:text-primary-400 transition-colors"
            >
              <Icon
                name="ri:linkedin-box-fill"
                class="w-4 h-4 text-primary-400/90 shrink-0 print:hidden"
              />
              <span class="truncate"
                >{
                  resumeData.header.linkedin
                    .replace("https://www.", "")
                    .replace("https://", "")
                }</span
              >
            </a>
            <a
              href={resumeData.header.website}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 hover:text-primary-400 transition-colors"
            >
              <Icon
                name="ri:global-line"
                class="w-4 h-4 text-primary-400/90 shrink-0 print:hidden"
              />
              <span class="truncate"
                >{resumeData.header.website.replace("https://", "")}</span
              >
            </a>
          </div>
        </div>
      </header>

      <!-- Executive Summary -->
      <section class="mb-8">
        <h2
          class="text-xs font-bold text-primary-400 uppercase tracking-widest mb-3 border-b border-darkslate-700/60 pb-1.5 print:text-black print:border-gray-300"
        >
          Executive Summary
        </h2>
        <p
          class="text-darkslate-200 text-xs sm:text-sm leading-relaxed print:text-gray-800"
        >
          {resumeData.summary}
        </p>
      </section>

      <!-- Work Experience -->
      <section class="mb-8">
        <h2
          class="text-xs font-bold text-primary-400 uppercase tracking-widest mb-5 border-b border-darkslate-700/60 pb-1.5 print:text-black print:border-gray-300"
        >
          Professional Experience
        </h2>
        <div class="space-y-6">
          {
            resumeData.experience.map((exp) => (
              <div class="relative pl-4 border-l border-darkslate-600/60 print:border-gray-300">
                <div class="absolute -left-[4.5px] top-1.5 w-2 h-2 rounded-full bg-primary-400 print:bg-gray-700" />
                <div class="flex flex-col sm:flex-row sm:items-baseline justify-between gap-1 mb-1.5">
                  <h3 class="text-sm sm:text-base font-bold text-white print:text-black">
                    {exp.role}{" "}
                    <span class="text-darkslate-300 font-normal text-xs sm:text-sm print:text-gray-700">
                      @ {exp.company}
                    </span>
                  </h3>
                  <span class="text-xs font-mono text-darkslate-300 print:text-gray-600 shrink-0">
                    {exp.period}
                  </span>
                </div>
                <ul class="mt-2 space-y-1.5 text-xs sm:text-sm text-darkslate-200 print:text-gray-800">
                  {exp.highlights.map((h) => (
                    <li class="flex items-start gap-2">
                      <span class="text-primary-400/80 font-bold select-none mt-0.5 print:text-gray-600">
                        •
                      </span>
                      <span class="leading-relaxed">{h}</span>
                    </li>
                  ))}
                </ul>
              </div>
            ))
          }
        </div>
      </section>

      <!-- Technical Stack Matrix -->
      <section class="mb-8">
        <h2
          class="text-xs font-bold text-primary-400 uppercase tracking-widest mb-4 border-b border-darkslate-700/60 pb-1.5 print:text-black print:border-gray-300"
        >
          Technical Stack & Core Skills
        </h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          {
            resumeData.skills.map((group) => (
              <div class="bg-darkslate-900/50 border border-darkslate-700/50 rounded-xl p-3.5 print:bg-transparent print:border-gray-200">
                <h3 class="text-xs font-bold text-white uppercase tracking-wider mb-2 print:text-black">
                  {group.category}
                </h3>
                <div class="flex flex-wrap gap-1.5">
                  {group.items.map((item) => (
                    <span class="px-2 py-0.5 bg-darkslate-800/80 border border-darkslate-700/60 text-darkslate-200 rounded text-xs font-mono print:bg-gray-100 print:text-black print:border-gray-300">
                      {item}
                    </span>
                  ))}
                </div>
              </div>
            ))
          }
        </div>
      </section>

      <!-- Key Engineering Projects -->
      <section class="mb-8">
        <h2
          class="text-xs font-bold text-primary-400 uppercase tracking-widest mb-4 border-b border-darkslate-700/60 pb-1.5 print:text-black print:border-gray-300"
        >
          Key Engineering Projects
        </h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          {
            resumeData.projects.map((proj) => (
              <div class="bg-darkslate-900/40 border border-darkslate-700/50 rounded-xl p-4 print:bg-transparent print:border-gray-200">
                <h3 class="text-xs sm:text-sm font-bold text-white print:text-black">
                  {proj.name}
                </h3>
                <p class="text-[11px] font-mono text-primary-400/90 mt-1 mb-2 print:text-gray-700">
                  {proj.tech}
                </p>
                <p class="text-xs text-darkslate-200 print:text-gray-800 leading-relaxed">
                  {proj.desc}
                </p>
              </div>
            ))
          }
        </div>
      </section>

      <!-- Verified Certifications & Credentials -->
      <section class="mb-8">
        <h2
          class="text-xs font-bold text-primary-400 uppercase tracking-widest mb-4 border-b border-darkslate-700/60 pb-1.5 print:text-black print:border-gray-300"
        >
          Certifications & Credentials
        </h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
          {
            resumeData.certifications.map((cert) => (
              <div class="bg-darkslate-900/40 border border-darkslate-700/40 rounded-xl p-3.5 flex flex-col justify-between print:bg-transparent print:border-gray-200">
                <div>
                  <h3 class="text-xs font-bold text-white print:text-black">
                    {cert.title}
                  </h3>
                  <p class="text-xs text-darkslate-200 print:text-gray-700 mt-1">
                    {cert.issuer} •{" "}
                    <span class="font-mono text-darkslate-300 print:text-gray-600">
                      {cert.date}
                    </span>
                  </p>
                </div>
                <p class="text-[10px] font-mono text-darkslate-300 mt-2 truncate">
                  ID: {cert.id}
                </p>
              </div>
            ))
          }
        </div>
      </section>

      <!-- Education -->
      <section>
        <h2
          class="text-xs font-bold text-primary-400 uppercase tracking-widest mb-3 border-b border-darkslate-700/60 pb-1.5 print:text-black print:border-gray-300"
        >
          Education
        </h2>
        {
          resumeData.education.map((edu) => (
            <div class="bg-darkslate-900/40 border border-darkslate-700/40 rounded-xl p-4 print:bg-transparent print:border-gray-200">
              <div class="flex flex-col sm:flex-row sm:items-baseline justify-between gap-1">
                <div>
                  <h3 class="text-sm font-bold text-white print:text-black">
                    {edu.degree}
                  </h3>
                  <p class="text-xs text-darkslate-200 print:text-gray-700 mt-0.5">
                    {edu.institution}
                  </p>
                </div>
                <span class="text-xs font-mono text-darkslate-300 print:text-gray-600 shrink-0">
                  {edu.period}
                </span>
              </div>
              <p class="text-xs text-darkslate-300 print:text-gray-600 mt-2 italic leading-relaxed">
                {edu.details}
              </p>
            </div>
          ))
        }
      </section>
    </div>
  </main>
</Layout>
