---
import Layout from "../layouts/Layout.astro";
import BackLink from "../components/BackLink.astro";
import { SITE } from "../site-config";
import { db, Guestbook as GuestbookTable, desc, count } from "astro:db";
import GuestbookCard from "../components/guestbook/GuestbookCard.astro";
import GuestbookForm from "../components/guestbook/GuestbookForm.astro";
import GuestbookPagination from "../components/guestbook/GuestbookPagination.astro";
import { ENTRIES_PER_PAGE, type GuestbookEntry } from "../lib/guestbook";

const isGitHubPages = process.env.GITHUB_PAGES === "true";

let requestedPage = 1;
let totalEntries = 0;
let entries: GuestbookEntry[] = [];
let totalPages = 1;

if (!isGitHubPages) {
  requestedPage = Math.max(
    1,
    parseInt(Astro.url.searchParams.get("page") ?? "1", 10),
  );

  Astro.response.headers.set(
    "Cache-Control",
    "private, max-age=0, must-revalidate",
  );

  try {
    const totalResult = await db
      .select({ total: count() })
      .from(GuestbookTable);
    totalEntries = totalResult[0]?.total ?? 0;

    entries = await db
      .select()
      .from(GuestbookTable)
      .orderBy(desc(GuestbookTable.createdAt))
      .limit(ENTRIES_PER_PAGE)
      .offset((requestedPage - 1) * ENTRIES_PER_PAGE);

    totalPages = Math.max(1, Math.ceil(totalEntries / ENTRIES_PER_PAGE));
  } catch (e) {
    console.warn("[Guestbook] DB query skipped or failed:", e);
  }
}

---

<Layout
  title={`${SITE.author.fullNameVi} (${SITE.author.shortName}) — Guestbook`}
  description={`Leave a message, say hello, or connect with ${SITE.author.fullNameVi} (${SITE.author.shortName}), Software Engineer @ ${SITE.author.companyVi}.`}
  keywords={["Do Quoc Viet guestbook", "vietdoo guestbook", "connect with Do Quoc Viet", "vietdoo contact"]}
  hideCal={true}
>
  <div class="flex flex-col items-center px-4 pt-12 pb-24">
    <header class="w-full max-w-xl mb-12 text-center">
      <h1 class="text-white text-3xl font-bold tracking-tight mb-3">
        Guestbook
      </h1>
      <p class="text-darkslate-300 text-sm leading-relaxed">
        Drop a note, say hi, or share your thoughts. I read every message.
      </p>
    </header>

    <GuestbookForm class="w-full max-w-xl mb-12" />

    <section class="w-full max-w-3xl">
      <h2 id="entries-count" class="text-white text-sm font-semibold mb-4">
        {totalEntries} messages
      </h2>

      <div id="entries" class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        {
          entries.length === 0 ? (
            <p
              data-empty-state
              class="col-span-2 text-center py-20 text-darkslate-300 text-sm"
            >
              No messages yet — be the first to leave one.
            </p>
          ) : (
            entries.map((entry) => <GuestbookCard entry={entry} />)
          )
        }
      </div>

      <GuestbookPagination
        currentPage={requestedPage}
        totalPages={totalPages}
      />
    </section>
  </div>
</Layout>

<script>
  import { apiFetch, parseJsonResponse } from "../lib/api-config";
  import { renderGuestbookCardHtml, type GuestbookEntry } from "../lib/guestbook";

  async function initGuestbookClient() {
    const entriesContainer = document.getElementById("entries");
    const countEl = document.getElementById("entries-count");
    if (!entriesContainer) return;

    const hasEmptyState = Boolean(
      entriesContainer.querySelector("[data-empty-state]"),
    );
    const currentCards = entriesContainer.querySelectorAll("[data-entry-id]");

    // Nếu trang đang ở trạng thái rỗng (như trên bản tĩnh GitHub Pages), fetch động từ API
    if (hasEmptyState || currentCards.length === 0) {
      try {
        const urlParams = new URLSearchParams(window.location.search);
        const page = urlParams.get("page") || "1";

        const res = await apiFetch(
          `/api/guestbook?page=${encodeURIComponent(page)}`,
        );
        const parsed = await parseJsonResponse<{
          entries: GuestbookEntry[];
          total: number;
          page: number;
          totalPages: number;
        }>(res);

        if (parsed.ok && parsed.data && parsed.data.entries.length > 0) {
          if (countEl) {
            countEl.textContent = `${parsed.data.total} messages`;
          }

          entriesContainer.innerHTML = parsed.data.entries
            .map((entry) => renderGuestbookCardHtml(entry))
            .join("");
        }
      } catch (err) {
        console.warn("[Guestbook Client Loader] Failed to fetch entries:", err);
      }
    }
  }

  document.addEventListener("astro:page-load", initGuestbookClient);
</script>

