---
import { Image } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import LoaderAnimation from "../components/LoaderAnimation.astro";
import BackLink from "../components/BackLink.astro";
import { illustrationsAll } from "../lib/illustrations";
import { SITE } from "../site-config";

const architectureProjects = [
  {
    category: "Data Pipeline",
    title: "HCMC Property ETL & Analytics",
    description:
      "Automated data ingestion from real estate platforms into HDFS storage, distributed transformation using Apache Spark, warehouse loading to Amazon Redshift, and BI dashboarding with Apache Superset.",
    tags: ["HDFS", "Spark", "Redshift", "Superset"],
    githubUrl: "https://github.com/vietdoo/hcmc-houses-analysis",
  },
  {
    category: "AI Orchestration",
    title: "AI Agent Handover Architecture",
    description:
      "Repo-level state management pattern preventing context loss across LLM agent switches. Uses structured handover ledgers, routing maps, and forcing functions for seamless agentic workflows.",
    tags: ["Agentic AI", "State Ledger", "Claude", "Codex"],
    githubUrl: "https://github.com/vietdoo",
  },
];
---

<LoaderAnimation />

<script>
  function initLightbox() {
    const overlay = document.getElementById("lightbox-overlay") as HTMLElement;
    const lightboxImg = document.getElementById(
      "lightbox-img",
    ) as HTMLImageElement;
    const lightboxAlt = document.getElementById("lightbox-alt") as HTMLElement;

    function open(src: string, alt: string) {
      lightboxImg.src = src;
      lightboxImg.alt = alt;
      lightboxAlt.textContent = alt;
      overlay.classList.remove("opacity-0", "pointer-events-none");
      overlay.classList.add("opacity-100");
      document.body.style.overflow = "hidden";
    }

    function close() {
      overlay.classList.add("opacity-0", "pointer-events-none");
      overlay.classList.remove("opacity-100");
      document.body.style.overflow = "";
    }

    document.querySelectorAll<HTMLElement>(".masonry-item").forEach((item) => {
      item.style.cursor = "zoom-in";
      item.addEventListener("click", () => {
        const img = item.querySelector("img");
        if (img) open(img.src, img.alt);
      });
    });

    overlay.addEventListener("click", (e) => {
      if (e.target === overlay) close();
    });

    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape") close();
    });

    document.getElementById("lightbox-close")?.addEventListener("click", close);
  }

  document.addEventListener("astro:page-load", initLightbox);
</script>

<Layout
  title={`${SITE.author.fullNameVi} (${SITE.author.shortName}) — Engineering Showcase`}
  description={`Engineering diagrams, system architecture explorations, visual concepts, and technical illustrations by ${SITE.author.fullNameVi} (${SITE.author.shortName}), Software Engineer @ ${SITE.author.companyVi}.`}
  keywords={["Do Quoc Viet system architecture", "vietdoo engineering showcase", "Apache Spark ETL", "AI Agent Handover Architecture", "HCMC Property ETL"]}
  hideSoundToggle={true}
>
  <div
    id="lightbox-overlay"
    class="fixed inset-0 z-50 flex flex-col items-center justify-center bg-black/90 opacity-0 pointer-events-none transition-opacity duration-300 p-4"
  >
    <button
      id="lightbox-close"
      class="absolute top-4 right-4 text-white/60 hover:text-white transition-colors text-sm border border-white/20 hover:border-white/50 rounded-lg px-3 py-1.5"
    >
      esc
    </button>
    <img
      id="lightbox-img"
      src=""
      alt=""
      class="max-w-full max-h-[85vh] rounded-xl object-contain shadow-2xl"
    />
    <p id="lightbox-alt" class="mt-4 text-white/40 text-xs"></p>
  </div>

  <main class="w-full max-w-5xl mx-auto px-3.5 sm:px-6 py-6 sm:py-10 text-white">
    <h1 class="text-2xl sm:text-4xl font-bold mb-2">Engineering Showcase</h1>
    <p class="text-darkslate-300 text-xs sm:text-sm mb-8 sm:mb-10">
      System architecture blueprints, engineering diagrams, visual concepts, and technical illustrations.
    </p>

    <!-- System Architecture Breakdown -->
    <section class="mb-14 space-y-6">
      <h2 class="text-xl font-bold text-primary-400 flex items-center gap-2">
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
        </svg>
        System Architecture Blueprints
      </h2>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-4 sm:gap-6">
        {
          architectureProjects.map((project) => (
            <a
              href={project.githubUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="bg-darkslate-800/80 border border-darkslate-600/50 hover:border-darkslate-500/80 hover:bg-darkslate-800/95 transition-all duration-300 rounded-2xl p-4 sm:p-6 flex flex-col justify-between group relative shadow-md hover:shadow-xl hover:shadow-black/25 hover:-translate-y-1 cursor-pointer no-underline text-inherit"
            >
              <div>
                <div class="flex items-center justify-between gap-3 mb-3">
                  <span class="inline-block px-2.5 py-1 rounded-md text-[10px] uppercase font-bold tracking-wider bg-darkslate-700/60 border border-darkslate-500/40 text-primary-400">
                    {project.category}
                  </span>
                  <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-[11px] font-medium text-darkslate-200 bg-darkslate-700/80 border border-darkslate-500/60 shadow-sm opacity-90 sm:opacity-0 sm:translate-y-1.5 sm:scale-95 group-hover:opacity-100 group-hover:translate-y-0 group-hover:scale-100 group-hover:border-darkslate-400/80 group-hover:text-white transition-all duration-300 ease-out pointer-events-none">
                    <svg
                      class="w-3.5 h-3.5 text-white shrink-0"
                      viewBox="0 0 24 24"
                      fill="currentColor"
                    >
                      <path
                        fill-rule="evenodd"
                        clip-rule="evenodd"
                        d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"
                      />
                    </svg>
                    <span>View on GitHub</span>
                    <svg
                      class="w-3 h-3 text-darkslate-400 group-hover:text-white group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-all duration-200"
                      fill="none"
                      viewBox="0 0 24 24"
                      stroke="currentColor"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"
                      />
                    </svg>
                  </span>
                </div>
                <h3 class="text-base font-bold text-white transition-colors">
                  {project.title}
                </h3>
                <p class="text-xs text-darkslate-300 mt-2 leading-relaxed">
                  {project.description}
                </p>
              </div>
              <div class="mt-6 pt-4 border-t border-darkslate-700/50 flex flex-wrap gap-1.5 text-[11px] font-mono text-darkslate-300">
                {project.tags.map((tag) => (
                  <span class="px-2 py-0.5 rounded bg-darkslate-700/60">{tag}</span>
                ))}
              </div>
            </a>
          ))
        }
      </div>
    </section>

    <h2 class="text-xl font-bold text-primary-400 mb-6 flex items-center gap-2">
      <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
      </svg>
      Graphic & Visual Gallery
    </h2>

    <div class="masonry">
      {
        illustrationsAll.map(({ src, alt }) => (
          <div class="masonry-item">
            {typeof src === "string" ? (
              <img
                src={src}
                alt={alt}
                class="w-full h-auto rounded-xl object-cover"
                loading="eager"
                decoding="auto"
              />
            ) : (
              <Image
                src={src}
                alt={alt}
                class="w-full h-auto rounded-xl object-cover"
                loading="eager"
                decoding="auto"
              />
            )}
          </div>
        ))
      }
    </div>
  </main>
</Layout>

<style>
  .masonry {
    columns: 1;
    column-gap: 1rem;
  }

  @media (min-width: 640px) {
    .masonry {
      columns: 2;
    }
  }

  @media (min-width: 1024px) {
    .masonry {
      columns: 3;
    }
  }

  .masonry-item {
    break-inside: avoid;
    margin-bottom: 1rem;
    overflow: hidden;
    border-radius: 0.75rem;
    position: relative;
  }

  .masonry-item img {
    display: block;
    transition:
      transform 0.4s ease,
      filter 0.4s ease;
  }

  .masonry-item:hover img {
    transform: scale(1.03);
    filter: brightness(1.1);
  }
</style>
