---
import Layout from "../../layouts/Layout.astro";
import LoaderAnimation from "../../components/LoaderAnimation.astro";
import BackLink from "../../components/BackLink.astro";
import Card from "../../components/Card/index.astro";
import { SITE } from "../../site-config";

const projects = [
  {
    title: "Browser Fingerprint Audit",
    description:
      "Privacy-first browser fingerprint audit with an AI explanation",
    slug: "/fingerprint-audit",
    tags: ["SolidJS", "Privacy", "AI"],
  },
  {
    title: "Image describer",
    description: "Upload an image and generate a clear visual description",
    slug: "/image-description",
    tags: ["SolidJS", "AI"],
  },
  {
    title: "Dice roller",
    description: "Random 3D dice roller simulation with WebGL and physics",
    slug: "/dice-roller",
    tags: ["Three.js", "SolidJS"],
  },
  {
    title: "Task agent",
    description:
      "AI chat assistant with task assignment, action approval, and feedback flows",
    slug: "/task-agent",
    tags: ["SolidJS", "AI"],
  },
  {
    title: "Smart chat",
    description:
      "Provider-agnostic AI chat with automatic server-side routing and failover",
    slug: "/chat",
    tags: ["SolidJS", "AI", "Routing"],
  },
  {
    title: "Meta tag generator",
    description:
      "Generate SEO and Open Graph meta tags with social card live previews",
    slug: "/meta-tag-generator",
    tags: ["SolidJS", "SEO"],
  },
  {
    title: "Input tester",
    description: "Interactive keyboard key and mouse click tester",
    slug: "/input-tester",
    tags: ["SolidJS", "Utility"],
  },
  {
    title: "Color contrast checker",
    description:
      "WCAG accessibility contrast ratio calculator for text and background colors",
    slug: "/color-contrast",
    tags: ["SolidJS", "Design"],
  },
  {
    title: "JWT decoder",
    description: "JSON Web Token decoder and inspector",
    slug: "/jwt-decoder",
    tags: ["SolidJS", "Utility"],
  },
  {
    title: "Floating header",
    description: "Dynamic glassmorphism floating header and subpage shell demo",
    slug: "/floating-header",
    tags: ["SolidJS", "UI"],
  },
  {
    title: "Word counter",
    description: "Real-time word, character, and sentence counter",
    slug: "/word-counter",
    tags: ["SolidJS", "Utility"],
  },
];
---

<LoaderAnimation />

<Layout
  title={`${SITE.author.fullNameVi} (${SITE.author.shortName}) — Playground`}
  description={`Interactive web utilities, SolidJS components, tools, and creative engineering experiments by ${SITE.author.fullNameVi} (${SITE.author.shortName}), Software Engineer @ ${SITE.author.companyVi}.`}
  keywords={[
    "Do Quoc Viet playground",
    "vietdoo playground",
    "vietdoo web tools",
    "vietdoo solidjs experiments",
  ]}
>
  <main
    class="playground-page w-full min-h-screen flex flex-col justify-start items-start max-w-3xl mx-auto px-3.5 sm:px-8 py-6 sm:py-8 text-white"
  >
    <h1 class="text-2xl sm:text-3xl font-bold mb-1 text-white tracking-tight">
      Playground
    </h1>
    <p class="text-xs sm:text-sm text-darkslate-300 mb-6 sm:mb-8">
      Interactive web utilities, SolidJS components, and creative engineering experiments.
    </p>
    <div class="grid grid-cols-2 gap-4 w-full" id="playground-grid">
      {
        projects.map((project, i) => (
          <div
            class="col-span-2 md:col-span-1 flex"
            data-playground-card
            data-search-text={`${project.title} ${project.description} ${project.tags.join(" ")}`.toLowerCase()}
          >
            <Card
              href={`/playground${project.slug}`}
              height="h-auto"
              colSpan="w-full"
              arrowCorner={true}
            >
              <div class="flex flex-col gap-3">
                <span class="text-[10px] font-medium tabular-nums text-darkslate-400 tracking-widest">
                  {String(i + 1).padStart(2, "0")}
                </span>
                <div>
                  <h2 class="font-semibold text-lg leading-snug text-darkslate-50">
                    {project.title}
                  </h2>
                  <p class="text-darkslate-300 text-sm mt-1">
                    {project.description}
                  </p>
                </div>
                <div class="flex flex-wrap gap-1.5 mt-1">
                  {project.tags.map((tag) => (
                    <span class="text-[10px] font-medium px-2 py-0.5 rounded-full border border-darkslate-400 text-darkslate-300">
                      {tag}
                    </span>
                  ))}
                </div>
              </div>
            </Card>
          </div>
        ))
      }
    </div>
    <div
      id="playground-empty"
      class="hidden text-darkslate-400 text-sm py-12 w-full text-center"
    >
      No playground tools match your search query.
    </div>
  </main>
</Layout>

<style is:global>
  .playground-page,
  .playground-page h1,
  .playground-page h2,
  .playground-page p,
  .playground-page span {
    font-family: var(--font-satoshi), "Inter", "Be Vietnam Pro", system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  }
</style>

<script>
  function setupPlaygroundSearch() {
    const grid = document.getElementById("playground-grid");
    const emptyMsg = document.getElementById("playground-empty");
    if (!grid) return;

    const cards = grid.querySelectorAll<HTMLElement>("[data-playground-card]");

    function filterCards(query: string) {
      const q = query.toLowerCase().trim();
      let matchCount = 0;

      cards.forEach((card) => {
        const searchText = card.dataset.searchText || "";
        const matches = !q || searchText.includes(q);
        card.style.display = matches ? "" : "none";
        if (matches) matchCount++;
      });

      if (emptyMsg) {
        emptyMsg.classList.toggle(
          "hidden",
          matchCount > 0 || cards.length === 0,
        );
      }
    }

    const params = new URLSearchParams(window.location.search);
    const initialQuery = params.get("q") || "";
    filterCards(initialQuery);

    window.addEventListener("header-search", (e: any) => {
      filterCards(e.detail?.query || "");
    });
  }

  document.addEventListener("astro:page-load", setupPlaygroundSearch);
  setupPlaygroundSearch();
</script>
