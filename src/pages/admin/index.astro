---
import Layout from "../../layouts/Layout.astro";
import AdminDashboard from "../../components/admin/AdminDashboard";
---

<Layout
  title="vndo-ai / Control room"
  description="Private administration console for vndo-ai AI request observability and model controls."
  hideCal={true}
  hideSoundToggle={true}
>
  <AdminDashboard client:load />
</Layout>

<style is:global>
  :root {
    color-scheme: dark;
  }
  body {
    background: #080a0e;
  }
  .admin-app {
    min-height: 100vh;
    background: #080a0e;
    color: #f4f7fb;
    font-family: "DM Sans", "Inter", ui-sans-serif, system-ui, sans-serif;
  }
  .admin-app *,
  .admin-app *::before,
  .admin-app *::after {
    box-sizing: border-box;
  }
  .admin-loading,
  .dashboard-loading {
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    color: #8d98a7;
    font-size: 13px;
    letter-spacing: 0.01em;
  }
  .admin-spinner {
    width: 18px;
    height: 18px;
    border: 2px solid rgba(82, 171, 255, 0.18);
    border-top-color: #53aaff;
    border-radius: 999px;
    animation: spin 0.7s linear infinite;
  }
  @keyframes spin {
    to {
      transform: rotate(360deg);
    }
  }
  .admin-login-page {
    min-height: 100vh;
    display: grid;
    place-items: center;
    padding: 24px;
    overflow: hidden;
    position: relative;
    background: radial-gradient(
      circle at 50% 0%,
      #111b2b 0,
      #080a0e 44%,
      #080a0e 100%
    );
  }
  .login-card {
    position: relative;
    width: min(100%, 424px);
    padding: 44px;
    border: 1px solid rgba(176, 193, 216, 0.16);
    border-radius: 24px;
    background: rgba(16, 20, 28, 0.88);
    box-shadow:
      0 24px 80px rgba(0, 0, 0, 0.46),
      inset 0 1px rgba(255, 255, 255, 0.05);
    backdrop-filter: blur(24px);
    z-index: 1;
  }
  .brand-mark {
    width: 48px;
    height: 48px;
    display: grid;
    place-items: center;
    margin-bottom: 38px;
    border-radius: 14px;
    background: linear-gradient(145deg, #79c6ff, #2c8be8);
    color: #07111f;
    font-size: 24px;
    font-weight: 900;
    letter-spacing: -0.1em;
    box-shadow: 0 8px 28px rgba(46, 145, 239, 0.36);
  }
  .brand-mark.small {
    width: 34px;
    height: 34px;
    margin: 0;
    border-radius: 10px;
    font-size: 17px;
  }
  .eyebrow {
    display: block;
    color: #738092;
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }
  .eyebrow.accent {
    color: #62b6ff;
  }
  .login-card h1 {
    margin: 12px 0 10px;
    font-size: clamp(35px, 5vw, 48px);
    line-height: 1;
    letter-spacing: -0.055em;
  }
  .login-card > p {
    margin: 0;
    color: #8b95a4;
    font-size: 14px;
    line-height: 1.7;
  }
  .login-form {
    display: grid;
    gap: 10px;
    margin-top: 34px;
  }
  .login-form label {
    color: #aeb7c5;
    font-size: 12px;
    font-weight: 700;
  }
  .login-form input {
    width: 100%;
    height: 48px;
    padding: 0 15px;
    border: 1px solid #293242;
    border-radius: 11px;
    outline: none;
    background: #0c1119;
    color: #fff;
    font: inherit;
    transition:
      border-color 0.2s,
      box-shadow 0.2s;
  }
  .login-form input:focus {
    border-color: #4ea8f6;
    box-shadow: 0 0 0 4px rgba(78, 168, 246, 0.11);
  }
  .primary-button {
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    min-height: 44px;
    padding: 0 16px;
    border: 0;
    border-radius: 10px;
    background: #53aaf7;
    color: #07111c;
    cursor: pointer;
    font: inherit;
    font-size: 12px;
    font-weight: 800;
    transition:
      transform 0.2s,
      background 0.2s,
      opacity 0.2s;
  }
  .primary-button:hover {
    background: #78c2ff;
    transform: translateY(-1px);
  }
  .primary-button:disabled {
    cursor: wait;
    opacity: 0.55;
    transform: none;
  }
  .login-button {
    width: 100%;
    margin-top: 10px;
  }
  .login-button span,
  .text-button span {
    font-size: 16px;
  }
  .form-error {
    padding: 10px 12px;
    border: 1px solid rgba(245, 112, 112, 0.25);
    border-radius: 9px;
    background: rgba(245, 112, 112, 0.08);
    color: #ff9b9b;
    font-size: 12px;
  }
  .login-footnote {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-top: 28px;
    color: #697586;
    font-size: 11px;
  }
  .status-dot,
  .system-online,
  .green-dot {
    display: inline-block;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #69dd9a;
    box-shadow: 0 0 0 4px rgba(105, 221, 154, 0.1);
  }
  .login-glow {
    position: absolute;
    width: 360px;
    height: 360px;
    border-radius: 50%;
    filter: blur(90px);
    opacity: 0.13;
    pointer-events: none;
  }
  .login-glow-one {
    top: -140px;
    left: 10%;
    background: #338fe8;
  }
  .login-glow-two {
    right: 5%;
    bottom: -180px;
    background: #884adf;
  }
  .admin-shell {
    min-height: 100vh;
    display: flex;
  }
  .admin-sidebar {
    width: 250px;
    flex: 0 0 250px;
    display: flex;
    flex-direction: column;
    padding: 25px 15px 18px;
    border-right: 1px solid #1a202a;
    background: #0b0e13;
  }
  .sidebar-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 10px 38px;
  }
  .admin-brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: #f2f5f9;
    text-decoration: none;
  }
  .admin-brand strong {
    display: block;
    font-size: 13px;
    letter-spacing: -0.02em;
  }
  .admin-brand em {
    display: block;
    margin-top: 2px;
    color: #6f7a8a;
    font-size: 10px;
    font-style: normal;
  }
  .live-chip {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: #71d99c;
    font-size: 9px;
    font-weight: 800;
    letter-spacing: 0.12em;
  }
  .live-chip i {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: #71d99c;
  }
  .sidebar-section-label {
    padding: 0 12px 10px;
    color: #536071;
    font-size: 9px;
    font-weight: 800;
    letter-spacing: 0.15em;
    text-transform: uppercase;
  }
  .admin-nav {
    display: grid;
    gap: 3px;
  }
  .nav-item {
    display: flex;
    align-items: center;
    gap: 11px;
    width: 100%;
    padding: 11px 12px;
    border: 0;
    border-radius: 9px;
    background: transparent;
    color: #7e8a9b;
    cursor: pointer;
    text-align: left;
    font: inherit;
    font-size: 12px;
    transition:
      background 0.2s,
      color 0.2s;
  }
  .nav-item:hover {
    color: #e4ebf4;
    background: #141a23;
  }
  .nav-item.active {
    color: #f3f7fb;
    background: linear-gradient(90deg, #18283a, #121923);
    box-shadow: inset 3px 0 #52aaf7;
  }
  .nav-item b {
    margin-left: auto;
    color: #617387;
    font-size: 10px;
    font-weight: 600;
  }
  .nav-icon {
    display: inline-grid;
    place-items: center;
    width: 24px;
    height: 20px;
    border: 1px solid #2a3442;
    border-radius: 5px;
    color: #758599;
    font-size: 7px;
    font-weight: 900;
    letter-spacing: 0.04em;
  }
  .nav-item.active .nav-icon {
    border-color: #3b7fb6;
    color: #74c0fb;
  }
  .sidebar-divider {
    height: 1px;
    margin: 30px 11px 28px;
    background: #1d2530;
  }
  .system-card {
    display: flex;
    align-items: center;
    gap: 9px;
    margin: 0 5px;
    padding: 12px 10px;
    border: 1px solid #202a36;
    border-radius: 11px;
    background: #11161e;
  }
  .system-icon {
    display: grid;
    place-items: center;
    width: 28px;
    height: 28px;
    border-radius: 8px;
    background: #172c3d;
    color: #66b6f9;
    font-size: 18px;
  }
  .system-card strong,
  .system-card small {
    display: block;
  }
  .system-card strong {
    color: #cbd5e1;
    font-size: 11px;
  }
  .system-card small {
    margin-top: 3px;
    color: #6f7c8d;
    font-size: 10px;
  }
  .system-online {
    width: 5px;
    height: 5px;
    margin-left: auto;
  }
  .sidebar-bottom {
    display: grid;
    gap: 10px;
    margin-top: auto;
    padding: 26px 7px 0;
  }
  .back-link,
  .logout-button {
    color: #717d8c;
    font: inherit;
    font-size: 11px;
    text-decoration: none;
  }
  .back-link:hover,
  .logout-button:hover {
    color: #b9c6d5;
  }
  .logout-button {
    padding: 10px 0 0;
    border: 0;
    border-top: 1px solid #1d2530;
    background: transparent;
    cursor: pointer;
    text-align: left;
  }
  .logout-button span {
    float: right;
    color: #4e5b6c;
    font-size: 15px;
  }
  .admin-main {
    width: calc(100% - 250px);
    min-width: 0;
    padding: 39px clamp(24px, 5vw, 72px) 60px;
    background:
      radial-gradient(
        circle at 88% 0%,
        rgba(34, 91, 142, 0.14),
        transparent 33%
      ),
      #0a0d12;
  }
  .admin-header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 20px;
    padding-bottom: 38px;
  }
  .admin-header h1 {
    margin: 8px 0 0;
    font-size: clamp(26px, 3vw, 36px);
    letter-spacing: -0.05em;
  }
  .header-actions {
    display: flex;
    align-items: center;
    gap: 13px;
  }
  .header-time {
    color: #657284;
    font-size: 11px;
  }
  .icon-button {
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    border: 1px solid #293444;
    border-radius: 9px;
    background: #111720;
    color: #9baabd;
    cursor: pointer;
    font-size: 18px;
  }
  .icon-button:hover {
    color: #fff;
    border-color: #427aa8;
  }
  .icon-button:focus-visible {
    color: #fff;
    outline: 2px solid #427aa8;
    outline-offset: 2px;
  }
  .icon-button:disabled {
    opacity: 0.5;
    cursor: wait;
  }
  .avatar {
    display: grid;
    place-items: center;
    width: 31px;
    height: 31px;
    border-radius: 50%;
    background: linear-gradient(135deg, #f5bc75, #e67d88);
    color: #251820;
    font-size: 11px;
    font-weight: 900;
  }
  .dashboard-content {
    max-width: 1360px;
  }
  .hero-panel {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 220px;
    padding: 34px 44px;
    border: 1px solid #1f2d3b;
    border-radius: 18px;
    overflow: hidden;
    position: relative;
    background: linear-gradient(112deg, #102133, #0e171f 60%, #11131c);
  }
  .hero-panel::after {
    content: "";
    position: absolute;
    width: 450px;
    height: 450px;
    top: -260px;
    right: 18%;
    border: 1px solid rgba(83, 170, 247, 0.12);
    border-radius: 50%;
    box-shadow:
      0 0 0 42px rgba(83, 170, 247, 0.025),
      0 0 0 84px rgba(83, 170, 247, 0.02);
  }
  .hero-panel h2,
  .page-intro h2 {
    margin: 11px 0 8px;
    font-size: clamp(25px, 3vw, 36px);
    letter-spacing: -0.055em;
  }
  .hero-panel p,
  .page-intro p {
    max-width: 500px;
    margin: 0;
    color: #8b98a9;
    font-size: 13px;
    line-height: 1.7;
  }
  .hero-orbit {
    position: relative;
    z-index: 1;
    width: 116px;
    height: 116px;
    display: grid;
    place-items: center;
    margin-right: 8%;
    border: 1px solid rgba(94, 183, 255, 0.18);
    border-radius: 50%;
    color: #71c0ff;
  }
  .hero-orbit span {
    position: absolute;
    inset: 12px;
    border: 1px dashed rgba(94, 183, 255, 0.24);
    border-radius: 50%;
  }
  .hero-orbit span:nth-child(2) {
    inset: 25px;
    border-style: solid;
    border-color: rgba(94, 183, 255, 0.16);
  }
  .hero-orbit span:nth-child(3) {
    inset: 38px;
    border: 2px solid rgba(94, 183, 255, 0.42);
  }
  .hero-orbit strong {
    position: relative;
    font-size: 25px;
    letter-spacing: -0.05em;
  }
  .hero-orbit small {
    position: absolute;
    top: 70px;
    left: 78px;
    color: #6c879f;
    font-size: 8px;
    line-height: 1.2;
    text-transform: uppercase;
  }
  .metric-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 12px;
    margin: 18px 0 42px;
  }
  .metric-card {
    min-height: 126px;
    padding: 19px 20px;
    border: 1px solid #1e2732;
    border-radius: 13px;
    background: #10141a;
  }
  .metric-card > span {
    display: block;
    color: #7d8999;
    font-size: 11px;
  }
  .metric-card > strong {
    display: block;
    margin: 15px 0 5px;
    color: #f3f7fb;
    font-size: 28px;
    letter-spacing: -0.06em;
  }
  .metric-card > small {
    color: #596777;
    font-size: 10px;
  }
  .inline-muted {
    color: #697687;
    font-size: 14px;
    font-weight: 500;
    letter-spacing: 0;
  }
  .section-heading {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    margin: 0 0 15px;
  }
  .section-heading h3 {
    margin: 7px 0 0;
    font-size: 17px;
    letter-spacing: -0.035em;
  }
  .text-button {
    border: 0;
    background: transparent;
    color: #6aaee2;
    cursor: pointer;
    font: inherit;
    font-size: 11px;
  }
  .text-button:hover {
    color: #b7ddfa;
  }
  .text-button span {
    margin-left: 5px;
  }
  .model-heading {
    margin-top: 43px;
  }
  .log-table-wrap {
    overflow: auto;
    border: 1px solid #202a35;
    border-radius: 13px;
    background: #0f1319;
  }
  .log-table {
    width: 100%;
    min-width: 780px;
    border-collapse: collapse;
    text-align: left;
  }
  .log-table th {
    padding: 13px 16px;
    border-bottom: 1px solid #202a35;
    color: #647183;
    font-size: 9px;
    font-weight: 800;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    white-space: nowrap;
  }
  .log-table td {
    padding: 14px 16px;
    border-bottom: 1px solid #19212b;
    color: #8e9bac;
    font-size: 11px;
    white-space: nowrap;
  }
  .log-table tbody tr {
    cursor: pointer;
    transition: background 0.15s;
  }
  .log-table tbody tr:hover {
    background: #151c25;
  }
  .log-table tbody tr:last-child td {
    border-bottom: 0;
  }
  .status-pill {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 38px;
    padding: 4px 7px;
    border-radius: 5px;
    background: rgba(104, 219, 151, 0.1);
    color: #72dda0;
    font-size: 9px;
    font-weight: 800;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }
  .status-pill.failure {
    background: rgba(246, 121, 121, 0.1);
    color: #ff9696;
  }
  .request-id {
    color: #c5d1de;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 10px;
    font-weight: 500;
  }
  .fallback-label {
    display: inline-block;
    margin-left: 7px;
    color: #e6b36c;
    font-size: 9px;
  }
  .capability-list {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
  }
  .capability-list span {
    padding: 3px 6px;
    border: 1px solid #263747;
    border-radius: 4px;
    background: #121d27;
    color: #78b6dc;
    font-size: 9px;
  }
  .empty-state {
    padding: 50px !important;
    color: #647183 !important;
    text-align: center;
  }
  .page-intro {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: 28px;
  }
  .small-button {
    min-height: 38px;
    white-space: nowrap;
  }
  .log-summary {
    display: flex;
    gap: 22px;
    margin-bottom: 13px;
    color: #687586;
    font-size: 10px;
  }
  .log-summary span {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }
  .provider-sessions {
    display: flex;
    flex-direction: column;
    gap: 18px;
  }
  .provider-session {
    overflow: hidden;
    border: 1px solid #202b37;
    border-radius: 16px;
    background: #10161d;
  }
  .provider-session-header {
    display: flex;
    align-items: center;
    gap: 13px;
    padding: 17px 19px;
    border-bottom: 1px solid #202b37;
  }
  .provider-session-mark {
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    flex: 0 0 auto;
    border: 1px solid #34506a;
    border-radius: 10px;
    color: #72bfff;
    font-size: 10px;
    font-weight: 900;
  }
  .provider-session-copy {
    min-width: 0;
    flex: 1;
  }
  .provider-session-copy .eyebrow {
    display: block;
    margin-bottom: 4px;
  }
  .provider-session-copy h3 {
    margin: 0;
    color: #eaf0f7;
    font-size: 15px;
    letter-spacing: -0.025em;
  }
  .provider-session-copy p {
    display: flex;
    gap: 7px;
    margin: 4px 0 0;
    color: #69788a;
    font-size: 10px;
  }
  .provider-session-health {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    color: #69788a;
    font-size: 10px;
    white-space: nowrap;
  }
  .session-health-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #72dda0;
    box-shadow: 0 0 0 4px rgba(104, 219, 151, 0.1);
  }
  .session-health-dot.offline {
    background: #cf8d74;
    box-shadow: 0 0 0 4px rgba(207, 141, 116, 0.1);
  }
  .provider-model-grid {
    padding: 13px;
  }
  .model-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 13px;
  }
  .provider-model-grid.model-grid {
    margin: 0;
  }
  .model-card {
    min-height: 208px;
    padding: 19px;
    border: 1px solid #202b37;
    border-radius: 14px;
    background: linear-gradient(145deg, #121820, #0d1117);
    transition:
      border-color 0.2s,
      transform 0.2s,
      opacity 0.2s;
  }
  .model-card:hover {
    border-color: #31516a;
    transform: translateY(-2px);
  }
  .model-card.is-disabled {
    opacity: 0.55;
  }
  .model-card-top,
  .model-card-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .model-logo {
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    border: 1px solid #34506a;
    border-radius: 9px;
    color: #72bfff;
    font-size: 10px;
    font-weight: 900;
  }
  .model-status {
    padding: 5px 7px;
    border-radius: 5px;
    background: rgba(246, 177, 100, 0.1);
    color: #e8b66f;
    font-size: 9px;
    font-weight: 800;
    text-transform: uppercase;
  }
  .model-status.online {
    background: rgba(104, 219, 151, 0.1);
    color: #72dda0;
  }
  .model-card-title {
    min-width: 0;
    margin: 18px 0 12px;
  }
  .model-id-label {
    display: block;
    margin-bottom: 5px;
    color: #69788a;
    font-size: 8px;
    font-weight: 800;
    letter-spacing: 0.13em;
  }
  .model-card-title h3 {
    display: -webkit-box;
    overflow: hidden;
    margin: 0 0 5px;
    color: #eaf0f7;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 11px;
    line-height: 1.5;
    overflow-wrap: anywhere;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }
  .model-card-title p {
    overflow: hidden;
    margin: 0;
    color: #69788a;
    font-size: 10px;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .card-capabilities {
    min-height: 30px;
  }
  .model-card-footer {
    margin-top: 22px;
    padding-top: 13px;
    border-top: 1px solid #202a34;
    color: #677587;
    font-size: 10px;
  }
  .model-card-footer strong {
    color: #afbdd0;
    font-weight: 700;
  }
  .switch-button {
    width: 34px;
    height: 19px;
    padding: 2px;
    border: 0;
    border-radius: 999px;
    background: #303b49;
    cursor: pointer;
    transition: background 0.2s;
  }
  .switch-button i {
    display: block;
    width: 15px;
    height: 15px;
    border-radius: 50%;
    background: #7c8998;
    transition:
      transform 0.2s,
      background 0.2s;
  }
  .switch-button.on {
    background: #2d87c7;
  }
  .switch-button.on i {
    background: #d9f1ff;
    transform: translateX(15px);
  }
  .switch-button:disabled {
    cursor: not-allowed;
    opacity: 0.5;
  }
  .missing-key {
    display: block;
    margin-top: 9px;
    color: #cf8d74;
    font-size: 9px;
  }
  .model-callout {
    display: flex;
    align-items: flex-start;
    gap: 14px;
    margin-bottom: 21px;
    padding: 16px 18px;
    border: 1px solid #263d51;
    border-radius: 12px;
    background: rgba(44, 121, 177, 0.08);
  }
  .callout-icon {
    color: #67b8f5;
    font-size: 22px;
    line-height: 1;
  }
  .model-callout strong {
    color: #bfe4fc;
    font-size: 12px;
  }
  .model-callout p {
    margin: 5px 0 0;
    color: #7790a3;
    font-size: 11px;
    line-height: 1.6;
  }
  .admin-alert {
    margin-bottom: 20px;
    padding: 11px 14px;
    border: 1px solid rgba(255, 157, 104, 0.25);
    border-radius: 9px;
    background: rgba(255, 157, 104, 0.08);
    color: #ffbb8d;
    font-size: 11px;
  }
  .drawer-backdrop {
    position: fixed;
    z-index: 10;
    inset: 0;
    display: flex;
    justify-content: flex-end;
    background: rgba(0, 0, 0, 0.52);
    backdrop-filter: blur(5px);
  }
  .log-drawer {
    width: min(100%, 410px);
    padding: 38px 30px;
    overflow: auto;
    border-left: 1px solid #293646;
    background: #10151d;
    box-shadow: -20px 0 60px rgba(0, 0, 0, 0.35);
    animation: slide-in 0.25s ease-out;
  }
  @keyframes slide-in {
    from {
      transform: translateX(30px);
      opacity: 0;
    }
    to {
      transform: none;
      opacity: 1;
    }
  }
  .drawer-close {
    float: right;
    border: 0;
    border-radius: 6px;
    background: transparent;
    color: #7e8b9c;
    cursor: pointer;
    font-size: 27px;
    line-height: 1;
  }
  .drawer-close:focus-visible {
    outline: 2px solid #2d87c7;
    outline-offset: 2px;
  }
  .log-drawer h2 {
    margin: 11px 0 13px;
    color: #f3f6fa;
    font-size: 26px;
    letter-spacing: -0.05em;
  }
  .detail-list {
    display: grid;
    gap: 0;
    margin-top: 30px;
  }
  .detail-list > div {
    display: flex;
    justify-content: space-between;
    gap: 20px;
    padding: 14px 0;
    border-bottom: 1px solid #232d39;
  }
  .detail-list span {
    color: #6f7c8d;
    font-size: 11px;
  }
  .detail-list strong {
    max-width: 220px;
    color: #c9d4e0;
    font-size: 11px;
    font-weight: 600;
    text-align: right;
    overflow-wrap: anywhere;
  }
  .detail-list .error-text {
    color: #ff9999;
  }
  @media (max-width: 980px) {
    .metric-grid {
      grid-template-columns: repeat(2, 1fr);
    }
    .model-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .hero-orbit {
      margin-right: 0;
    }
  }
  @media (max-width: 720px) {
    .admin-sidebar {
      width: 66px;
      flex-basis: 66px;
      padding: 18px 8px;
    }
    .sidebar-top {
      justify-content: center;
      padding: 0 0 28px;
    }
    .admin-brand > span:not(.brand-mark),
    .live-chip,
    .sidebar-section-label,
    .nav-item > span:not(.nav-icon),
    .nav-item b,
    .sidebar-divider,
    .system-card > div,
    .system-card > i,
    .back-link,
    .logout-button {
      display: none;
    }
    .system-card {
      justify-content: center;
      margin: 0;
      padding: 10px 0;
      border: 0;
      background: transparent;
    }
    .system-icon {
      width: 32px;
      height: 32px;
    }
    .sidebar-bottom {
      padding: 20px 0 0;
    }
    .logout-button {
      display: block;
      border: 0;
      padding: 8px 0 0;
      text-align: center;
      font-size: 0;
    }
    .logout-button::before {
      content: "↗";
      color: #768495;
      font-size: 16px;
    }
    .logout-button span {
      display: none;
    }
    .admin-main {
      width: calc(100% - 66px);
      padding: 26px 16px 40px;
    }
    .admin-header {
      align-items: flex-start;
      padding-bottom: 26px;
    }
    .header-time {
      display: none;
    }
    .hero-panel {
      min-height: 235px;
      padding: 25px;
    }
    .hero-panel h2 {
      font-size: 27px;
    }
    .hero-orbit {
      position: absolute;
      right: -10px;
      bottom: -24px;
      opacity: 0.55;
    }
    .metric-grid {
      gap: 8px;
      margin-bottom: 31px;
    }
    .metric-card {
      min-height: 105px;
      padding: 14px;
    }
    .metric-card > strong {
      margin-top: 10px;
      font-size: 23px;
    }
    .section-heading {
      align-items: center;
    }
    .model-grid {
      grid-template-columns: 1fr;
    }
    .page-intro {
      display: block;
    }
    .page-intro .primary-button {
      margin-top: 18px;
    }
  }
  @media (max-width: 460px) {
    .login-card {
      padding: 30px 24px;
    }
    .login-card h1 {
      font-size: 38px;
    }
    .admin-header h1 {
      font-size: 25px;
    }
    .hero-panel {
      padding: 22px 19px;
    }
    .metric-card > span {
      font-size: 10px;
    }
    .metric-card > strong {
      font-size: 21px;
    }
  }
  /* Claude-inspired admin surface: warm neutrals, quiet borders, restrained accent. */
  :root {
    color-scheme: light;
  }
  body {
    background: #f6f4ef;
  }
  .admin-app {
    --admin-bg: #f6f4ef;
    --admin-sidebar: #eeece6;
    --admin-surface: #fbfaf7;
    --admin-surface-muted: #f2efe9;
    --admin-border: #ded9d0;
    --admin-border-soft: #e9e5de;
    --admin-ink: #2f2e2a;
    --admin-muted: #77736c;
    --admin-subtle: #9a958c;
    --admin-accent: #c86b4b;
    --admin-accent-dark: #a95037;
    --admin-success: #4d795b;
    --admin-danger: #b75443;
    min-height: 100vh;
    background: var(--admin-bg);
    color: var(--admin-ink);
    font-family: "DM Sans", "Inter", ui-sans-serif, system-ui, sans-serif;
  }
  .admin-loading,
  .dashboard-loading {
    color: var(--admin-muted);
  }
  .admin-spinner {
    border-color: rgba(200, 107, 75, 0.18);
    border-top-color: var(--admin-accent);
  }
  .admin-login-page {
    background: radial-gradient(
      circle at 50% 0%,
      #eee8df 0,
      #f6f4ef 55%,
      #f1eee8 100%
    );
  }
  .login-glow {
    display: none;
  }
  .login-card {
    padding: 42px;
    border: 1px solid var(--admin-border);
    border-radius: 18px;
    background: rgba(251, 250, 247, 0.96);
    box-shadow: 0 22px 70px rgba(65, 54, 43, 0.12);
    backdrop-filter: none;
  }
  .brand-mark {
    margin-bottom: 34px;
    border-radius: 12px;
    background: var(--admin-accent);
    color: #fffaf5;
    box-shadow: 0 8px 22px rgba(200, 107, 75, 0.2);
  }
  .eyebrow {
    color: var(--admin-subtle);
  }
  .eyebrow.accent {
    color: var(--admin-accent-dark);
  }
  .login-card h1 {
    color: var(--admin-ink);
    letter-spacing: -0.045em;
  }
  .login-card > p {
    color: var(--admin-muted);
  }
  .login-form label {
    color: #5f5b54;
  }
  .login-form input {
    border-color: #d8d3cb;
    background: #fffefa;
    color: var(--admin-ink);
  }
  .login-form input:focus {
    border-color: var(--admin-accent);
    box-shadow: 0 0 0 4px rgba(200, 107, 75, 0.12);
  }
  .primary-button {
    border-radius: 9px;
    background: var(--admin-accent);
    color: #fffaf5;
  }
  .primary-button:hover {
    background: var(--admin-accent-dark);
  }
  .form-error {
    border-color: rgba(183, 84, 67, 0.22);
    background: #fbefec;
    color: var(--admin-danger);
  }
  .login-footnote {
    color: var(--admin-subtle);
  }
  .status-dot,
  .system-online,
  .green-dot {
    background: var(--admin-success);
    box-shadow: 0 0 0 4px rgba(77, 121, 91, 0.1);
  }
  .admin-sidebar {
    width: 264px;
    flex-basis: 264px;
    padding: 26px 16px 18px;
    border-right-color: var(--admin-border);
    background: var(--admin-sidebar);
  }
  .sidebar-top {
    padding: 0 10px 38px;
  }
  .admin-brand {
    color: var(--admin-ink);
  }
  .admin-brand em {
    color: var(--admin-muted);
  }
  .live-chip {
    color: var(--admin-success);
  }
  .live-chip i {
    background: var(--admin-success);
  }
  .sidebar-section-label {
    color: #9a958c;
  }
  .nav-item {
    color: #77736c;
  }
  .nav-item:hover {
    color: var(--admin-ink);
    background: #e5e1d9;
  }
  .nav-item.active {
    color: var(--admin-ink);
    background: #e1dcd3;
    box-shadow: inset 3px 0 var(--admin-accent);
  }
  .nav-item b {
    color: #9a958c;
  }
  .nav-icon {
    width: 22px;
    height: 22px;
    border-color: #cbc5bb;
    border-radius: 6px;
    color: #8b857c;
    font-size: 15px;
    font-weight: 500;
    line-height: 1;
  }
  .nav-item.active .nav-icon {
    border-color: rgba(200, 107, 75, 0.5);
    color: var(--admin-accent-dark);
  }
  .sidebar-divider,
  .logout-button {
    border-color: #d8d2c8;
  }
  .system-card {
    border-color: #d9d3c9;
    background: rgba(251, 250, 247, 0.58);
  }
  .system-icon {
    background: #e5d9ce;
    color: var(--admin-accent-dark);
  }
  .system-card strong {
    color: #504c45;
  }
  .system-card small,
  .back-link,
  .logout-button {
    color: var(--admin-muted);
  }
  .back-link:hover,
  .logout-button:hover {
    color: var(--admin-accent-dark);
  }
  .admin-main {
    width: calc(100% - 264px);
    padding: 38px clamp(24px, 5vw, 76px) 64px;
    background: var(--admin-bg);
  }
  .admin-header h1 {
    color: var(--admin-ink);
  }
  .header-time {
    color: var(--admin-muted);
  }
  .icon-button {
    border-color: var(--admin-border);
    background: var(--admin-surface);
    color: var(--admin-muted);
  }
  .icon-button:hover {
    color: var(--admin-accent-dark);
    border-color: rgba(200, 107, 75, 0.55);
  }
  .icon-button:focus-visible {
    color: var(--admin-accent-dark);
    outline: 2px solid var(--admin-accent);
    outline-offset: 2px;
  }
  .avatar {
    background: #dfc3af;
    color: #654332;
  }
  .hero-panel {
    min-height: 212px;
    padding: 34px 38px;
    border-color: #ddd3c7;
    border-radius: 16px;
    background: linear-gradient(120deg, #eee5da, #f3eee7 62%, #ebe7df);
  }
  .hero-panel::after {
    display: none;
  }
  .hero-panel h2,
  .page-intro h2,
  .section-heading h3 {
    color: var(--admin-ink);
  }
  .hero-panel p,
  .page-intro p {
    color: var(--admin-muted);
  }
  .hero-status-note {
    position: relative;
    z-index: 1;
    display: grid;
    gap: 8px;
    min-width: 160px;
    padding: 14px 16px;
    border-left: 2px solid var(--admin-accent);
    color: var(--admin-muted);
  }
  .hero-status-label {
    color: var(--admin-subtle);
    font-size: 9px;
    font-weight: 800;
    letter-spacing: 0.14em;
  }
  .hero-status-note strong {
    display: flex;
    align-items: center;
    gap: 9px;
    color: var(--admin-ink);
    font-size: 14px;
    font-weight: 700;
  }
  .hero-status-note small {
    color: var(--admin-muted);
    font-size: 10px;
  }
  .metric-grid {
    gap: 14px;
  }
  .metric-card {
    min-height: 124px;
    border-color: var(--admin-border-soft);
    border-radius: 12px;
    background: var(--admin-surface);
    box-shadow: 0 6px 22px rgba(76, 65, 53, 0.045);
  }
  .metric-card > span {
    color: var(--admin-muted);
  }
  .metric-card > strong {
    color: var(--admin-ink);
  }
  .metric-card > small,
  .inline-muted {
    color: var(--admin-subtle);
  }
  .ai-summary-card {
    margin: 0 0 42px;
    padding: 22px 24px 18px;
    border: 1px solid #e0d2c6;
    border-radius: 14px;
    background: linear-gradient(110deg, #f8f1ea, #fbfaf7 72%);
    box-shadow: 0 7px 24px rgba(76, 65, 53, 0.045);
  }
  .ai-summary-card.attention {
    border-color: #e5c1b7;
    background: linear-gradient(110deg, #fbefec, #fbfaf7 72%);
  }
  .ai-summary-card.positive {
    border-color: #d5dfd4;
  }
  .ai-summary-heading {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 18px;
  }
  .ai-summary-heading h3 {
    margin: 7px 0 0;
    color: var(--admin-ink);
    font-size: 18px;
    letter-spacing: -0.035em;
  }
  .ai-summary-badge {
    flex: 0 0 auto;
    padding: 5px 8px;
    border: 1px solid #e2d4c8;
    border-radius: 999px;
    background: rgba(255, 253, 249, 0.75);
    color: var(--admin-accent-dark);
    font-size: 9px;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .ai-summary-list {
    display: grid;
    gap: 8px;
    margin: 17px 0 16px;
    padding: 0;
    list-style: none;
  }
  .ai-summary-list li {
    position: relative;
    padding-left: 17px;
    color: #69645d;
    font-size: 12px;
    line-height: 1.55;
  }
  .ai-summary-list li::before {
    content: "";
    position: absolute;
    top: 0.62em;
    left: 1px;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--admin-accent);
  }
  .ai-summary-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding-top: 12px;
    border-top: 1px solid rgba(220, 207, 196, 0.78);
    color: var(--admin-subtle);
    font-size: 10px;
  }
  .ai-summary-loading,
  .ai-summary-error {
    display: flex;
    align-items: center;
    gap: 9px;
    min-height: 62px;
    color: var(--admin-muted);
    font-size: 12px;
    line-height: 1.55;
  }
  .ai-summary-error {
    justify-content: space-between;
    gap: 16px;
    color: var(--admin-danger);
  }
  .ai-summary-error .text-button {
    flex: 0 0 auto;
  }
  .summary-pulse {
    display: inline-block;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--admin-accent);
    box-shadow: 0 0 0 5px rgba(200, 107, 75, 0.12);
  }
  .text-button {
    color: var(--admin-accent-dark);
  }
  .text-button:hover {
    color: var(--admin-accent);
  }
  .log-table-wrap {
    border-color: var(--admin-border-soft);
    border-radius: 12px;
    background: var(--admin-surface);
    box-shadow: 0 6px 22px rgba(76, 65, 53, 0.04);
  }
  .log-table th {
    border-bottom-color: var(--admin-border-soft);
    background: #f8f6f1;
    color: #918b82;
  }
  .log-table td {
    border-bottom-color: #eeeae3;
    color: #77736c;
  }
  .log-table tbody tr:hover {
    background: #f5f1eb;
  }
  .status-pill {
    background: #eaf2eb;
    color: var(--admin-success);
  }
  .status-pill.failure {
    background: #faece9;
    color: var(--admin-danger);
  }
  .request-id {
    color: #555149;
  }
  .fallback-label {
    color: #a56a35;
  }
  .capability-list span {
    border-color: #e1d8ce;
    background: #f4eee8;
    color: #91634f;
  }
  .empty-state {
    color: var(--admin-subtle) !important;
  }
  .log-summary {
    color: var(--admin-muted);
  }
  .provider-session {
    border-color: var(--admin-border-soft);
    border-radius: 14px;
    background: #faf8f4;
    box-shadow: 0 8px 24px rgba(76, 65, 53, 0.035);
  }
  .provider-session-header {
    border-bottom-color: var(--admin-border-soft);
    background: #f7f3ee;
  }
  .provider-session-mark {
    border-color: #d7c1b2;
    color: var(--admin-accent-dark);
    background: #faf1ea;
  }
  .provider-session-copy h3 {
    color: var(--admin-ink);
  }
  .provider-session-copy p,
  .provider-session-health {
    color: var(--admin-muted);
  }
  .session-health-dot {
    background: var(--admin-success);
    box-shadow: 0 0 0 4px rgba(93, 132, 103, 0.1);
  }
  .session-health-dot.offline {
    background: var(--admin-danger);
    box-shadow: 0 0 0 4px rgba(174, 91, 72, 0.1);
  }
  .provider-model-grid {
    background: #fdfbf8;
  }
  .model-card {
    border-color: var(--admin-border-soft);
    border-radius: 12px;
    background: var(--admin-surface);
    box-shadow: 0 6px 22px rgba(76, 65, 53, 0.045);
  }
  .model-card:hover {
    border-color: #d3b6a6;
    transform: translateY(-1px);
  }
  .model-card.is-disabled {
    opacity: 0.58;
    background: #f1eee8;
  }
  .model-logo {
    border-color: #d7c1b2;
    color: var(--admin-accent-dark);
    background: #faf1ea;
  }
  .model-status {
    background: #f8eee3;
    color: #a56a35;
  }
  .model-status.online {
    background: #eaf2eb;
    color: var(--admin-success);
  }
  .model-card-title h3 {
    color: var(--admin-ink);
  }
  .model-id-label {
    color: #a18d7d;
  }
  .model-card-title p,
  .model-card-footer,
  .model-card-footer strong {
    color: var(--admin-muted);
  }
  .model-card-footer {
    border-top-color: var(--admin-border-soft);
  }
  .model-card-footer strong {
    color: #555149;
  }
  .switch-button {
    background: #c9c3b9;
  }
  .switch-button i {
    background: #f8f6f1;
  }
  .switch-button.on {
    background: var(--admin-accent);
  }
  .switch-button.on i {
    background: #fffaf5;
  }
  .missing-key {
    color: #a35d48;
  }
  .model-callout {
    border-color: #e0cbbb;
    background: #f7eee7;
  }
  .callout-icon {
    color: var(--admin-accent-dark);
  }
  .model-callout strong {
    color: #6b493c;
  }
  .model-callout p {
    color: #8b6f62;
  }
  .admin-alert {
    border-color: #e5c1b7;
    background: #fbefec;
    color: var(--admin-danger);
  }
  .drawer-backdrop {
    background: rgba(49, 43, 36, 0.25);
    backdrop-filter: blur(3px);
  }
  .log-drawer {
    border-left-color: var(--admin-border);
    background: var(--admin-surface);
    box-shadow: -20px 0 60px rgba(65, 54, 43, 0.14);
  }
  .drawer-close {
    color: var(--admin-muted);
  }
  .drawer-close:hover {
